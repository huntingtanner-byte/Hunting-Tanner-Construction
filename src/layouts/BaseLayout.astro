---
/**
 * Base layout: document shell, SEO head, fonts, header/footer, structured
 * data, analytics hooks, sticky mobile CTA.
 */
import "@fontsource-variable/source-serif-4";
import "@/styles/global.css";
// THEME PREVIEW (theme-preview branch only)
import "@/styles/theme-preview.css";
import ThemePreview from "@/components/ThemePreview.astro";
import SEOHead from "@/components/SEOHead.astro";
import StructuredData from "@/components/StructuredData.astro";
import Analytics from "@/components/Analytics.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StickyMobileCTA from "@/components/StickyMobileCTA.astro";
import DevBanner from "@/components/DevBanner.astro";
import { organizationSchema } from "@/lib/schema";

interface Props {
  title: string;
  description: string;
  /** Canonical path with trailing slash */
  path: string;
  noindex?: boolean;
  ogImage?: string;
  /**
   * Body data attribute used for standardized page-view events:
   * "service" | "service-area" | "projects" | undefined
   */
  pageType?: string;
  /** Extra JSON-LD blocks (breadcrumbs, service, FAQ). Org schema is automatic. */
  schemas?: Record<string, unknown>[];
  /** Include the Organization/GeneralContractor schema (homepage only). */
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  path,
  noindex = false,
  ogImage,
  pageType,
  schemas = [],
  includeOrgSchema = false,
} = Astro.props;

const allSchemas = includeOrgSchema
  ? [organizationSchema(), ...schemas]
  : schemas;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
    // Runs in <head> before paint so pages never flash the wrong palette.
    (function () {
      var q = new URLSearchParams(location.search);
      var get = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
      var set = function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
      var p = q.get("palette") || get("tp-palette") || "current";
      var b = q.get("buttons") || get("tp-buttons") || "light";
      var s = q.get("bands") || get("tp-bands") || "standard";
      if (q.get("palette")) set("tp-palette", p);
      if (q.get("buttons")) set("tp-buttons", b);
      if (q.get("bands")) set("tp-bands", s);
      document.documentElement.setAttribute("data-palette", p);
      document.documentElement.setAttribute("data-buttons", b);
      document.documentElement.setAttribute("data-bands", s);
    })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2c3135" />
    <SEOHead {title} {description} {path} {noindex} {ogImage} />
    {allSchemas.length > 0 && <StructuredData schemas={allSchemas} />}
    <Analytics />
  </head>
  <body data-page-type={pageType}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <DevBanner />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />
    <ThemePreview />
    <script>
      import "@/scripts/analytics";
    </script>
  </body>
</html>
