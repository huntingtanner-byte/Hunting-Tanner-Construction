---
import type { ServiceArea } from "@/data/service-areas";

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
---

<article class="area-card">
  <h3>
    <a href={area.href}>{area.name}<span class="area-state">, {area.state}</span></a>
  </h3>
  <p>{area.blurb}</p>
  <p class="area-link" aria-hidden="true">
    {area.schemaType === "AdministrativeArea"
      ? "Basement finishing county-wide →"
      : `Basement finishing in ${area.name} →`}
  </p>
</article>

<style>
  .area-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-5);
    transition: box-shadow 0.15s ease;
  }
  .area-card:hover {
    box-shadow: var(--shadow-md);
  }
  .area-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .area-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .area-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .area-card:hover h3 a {
    color: var(--color-accent);
  }
  .area-state {
    color: var(--color-muted);
    font-size: var(--text-base);
  }
  .area-card p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .area-link {
    font-weight: 700;
    color: var(--color-accent) !important;
    margin: 0;
  }
</style>
