---
/**
 * Project card. Shows the cover image, title, and scope for a real project
 * from src/data/projects.ts. Links to the full gallery on /projects/.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

/** Resolve gallery filenames against src/assets/projects/. */
const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const cover = project.gallery[0];
const coverImage = cover
  ? projectImages[`/src/assets/projects/${cover.src}`]?.default
  : undefined;
---

<article class="project-card">
  {coverImage && cover && (
    <a
      class="project-cover"
      href={`/projects/#${project.id}`}
      aria-label={`View the ${project.title} gallery`}
      tabindex="-1"
    >
      <Image
        src={coverImage}
        alt={cover.alt}
        width={720}
        height={540}
        loading="lazy"
      />
    </a>
  )}
  <div class="project-body">
    <h3><a href={`/projects/#${project.id}`}>{project.title}</a></h3>
    <p class="project-meta">
      {project.location && <span>{project.location} · </span>}{project.scope}
    </p>
  </div>
</article>

<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .project-cover {
    display: block;
  }
  .project-cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .project-body {
    padding: var(--space-5);
  }
  .project-body h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .project-body h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .project-card:hover .project-body h3 a {
    color: var(--color-accent);
  }
  .project-meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
  }
</style>
