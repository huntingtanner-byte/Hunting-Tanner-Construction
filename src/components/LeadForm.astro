---
/**
 * Consultation lead form.
 *  - variant="compact": homepage / CTA sections (required fields only)
 *  - variant="detailed": contact page (adds optional qualifying fields)
 *
 * Architecture:
 *  - Posts to the (future) /api/contact serverless endpoint
 *  - Hidden attribution fields are filled client-side from sessionStorage
 *  - Optional photos / plan set upload straight to private Blob storage
 *    and ride along on the lead email (src/lib/uploads.ts)
 *  - Honeypot field + Turnstile placeholder for spam protection
 *  - While siteStatus is "staging", submission is intercepted and disabled;
 *    a safe mock payload is logged in dev. No email is ever sent in staging.
 */
import { business } from "@/config/business";
import { allServiceCities } from "@/data/cities";

interface Props {
  variant?: "compact" | "detailed";
  /** Unique id prefix so multiple forms can exist on one page */
  formId: string;
  heading?: string;
  /**
   * Pre-fills the project city. Used on city landing pages so a visitor
   * who arrived from a local search has one less field to complete.
   */
  defaultCity?: string;
}

const { variant = "compact", formId, heading, defaultCity = "" } = Astro.props;
const detailed = variant === "detailed";

const cityOptions = allServiceCities.map((c) => c.name);

const projectTypes = [
  "Full basement finish",
  "Basement remodel (already finished)",
  "Basement bathroom or bedroom",
  "Wet bar / kitchenette",
  "Other residential remodeling",
  "Not sure yet",
];

const investmentRanges = [
  "Not sure yet",
  "Under $50,000",
  "$50,000–$75,000",
  "$75,000–$100,000",
  "$100,000–$150,000",
  "$150,000+",
];

const timingOptions = [
  "As soon as possible",
  "1–3 months",
  "3–6 months",
  "6+ months / still planning",
];

const referralOptions = [
  "Google search",
  "Google Maps / Business Profile",
  "Instagram",
  "TikTok",
  "Facebook",
  "Friend or family referral",
  "Saw a project in my neighborhood",
  "Other",
];

const contactMethods = ["Phone call", "Text", "Email"];

const id = (name: string) => `${formId}-${name}`;
---

<form
  class="lead-form"
  id={formId}
  method="POST"
  action={business.form.endpoint}
  novalidate
  data-lead-form
  data-staging={business.form.enabled ? "false" : "true"}
  data-variant={variant}
>
  {/* h2 keeps the document outline valid: on the homepage this heading
      follows the h1 directly, so an h3 would skip a level. */}
  {heading && <h2 class="lead-form-heading">{heading}</h2>}

  <p
    class="form-status"
    data-form-status
    role="status"
    aria-live="polite"
    hidden
  >
  </p>

  {/* Paired rows keep the whole form on one phone screen (Hunting,
      November 2026): only name and phone are required. */}
  <div class="field-row">
    <div class="field">
      <label for={id("name")}>Name</label>
      <input
        type="text"
        id={id("name")}
        name="name"
        autocomplete="name"
        required
        maxlength="120"
        data-error-message="Please enter your name."
      />
      <p class="field-error" data-error-for={id("name")} hidden></p>
    </div>

    <div class="field">
      <label for={id("phone")}>Phone</label>
      <input
        type="tel"
        id={id("phone")}
        name="phone"
        autocomplete="tel"
        inputmode="tel"
        required
        maxlength="25"
        data-error-message="Please enter a phone number so we can reach you."
      />
      <p class="field-error" data-error-for={id("phone")} hidden></p>
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for={id("email")}>Email <span class="optional">(optional)</span></label>
      <input
        type="email"
        id={id("email")}
        name="email"
        autocomplete="email"
        inputmode="email"
        maxlength="120"
        data-error-message="Please enter a valid email address."
      />
      <p class="field-error" data-error-for={id("email")} hidden></p>
    </div>

    <div class="field">
      <label for={id("city")}>City <span class="optional">(optional)</span></label>
      <input
        type="text"
        id={id("city")}
        name="projectCity"
        autocomplete="address-level2"
        maxlength="60"
        list={id("city-list")}
        value={defaultCity}
        data-error-message="Which city is the project in?"
      />
      <datalist id={id("city-list")}>
        {cityOptions.map((city) => <option value={city} />)}
      </datalist>
      <p class="field-error" data-error-for={id("city")} hidden></p>
    </div>
  </div>

  {/* Contact page only: the qualifying questions stay available but
      folded away, so the form still starts short. */}
  {detailed && (
    <details class="form-more">
      <summary>Add project details <span class="optional">(optional)</span></summary>

      <div class="field">
        <label for={id("project-type")}>Project type <span class="optional">(optional)</span></label>
        <select
          id={id("project-type")}
          name="projectType"
          data-error-message="Please choose the closest project type."
        >
          <option value="">Select one…</option>
          {projectTypes.map((type) => <option value={type}>{type}</option>)}
        </select>
        <p class="field-error" data-error-for={id("project-type")} hidden></p>
      </div>

      <div class="field">
        <label for={id("sqft")}>
          Approximate finished square footage <span class="optional">(optional)</span>
        </label>
        <input
          type="text"
          id={id("sqft")}
          name="squareFootage"
          inputmode="numeric"
          maxlength="12"
        />
      </div>

      <div class="field">
        <label for={id("timing")}>
          Desired project timing <span class="optional">(optional)</span>
        </label>
        <select id={id("timing")} name="timing">
          <option value="">Select one…</option>
          {timingOptions.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>

      <div class="field">
        <label for={id("budget")}>
          Approximate investment range <span class="optional">(optional)</span>
        </label>
        <select id={id("budget")} name="investmentRange">
          <option value="">Select one…</option>
          {investmentRanges.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <div class="field">
        <label for={id("referral")}>
          How did you hear about us? <span class="optional">(optional)</span>
        </label>
        <select id={id("referral")} name="referralSource">
          <option value="">Select one…</option>
          {referralOptions.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <div class="field">
        <label for={id("contact-method")}>
          Preferred contact method <span class="optional">(optional)</span>
        </label>
        <select id={id("contact-method")} name="preferredContact">
          <option value="">Select one…</option>
          {contactMethods.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>
    </details>
  )}

  <div class="field">
    <label for={id("message")}>
      Tell us about your basement <span class="optional">(optional)</span>
    </label>
    <textarea
      id={id("message")}
      name="message"
      rows="3"
      maxlength="3000"
      data-error-message="A sentence or two about your project helps us prepare."
    ></textarea>
    <p class="field-error" data-error-for={id("message")} hidden></p>
  </div>

  {/* Optional photos or a plan set (November 2026). Each file uploads as
      soon as it's picked and arrives attached to the lead email; see
      src/lib/uploads.ts. Live forms only: staging never uploads. */}
  {business.form.enabled && (
    <div class="field file-field" data-file-field>
      <button
        type="button"
        class="file-pick"
        data-file-button
        aria-describedby={id("files-error")}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
        </svg>
        Add photos or plans <span class="optional">(optional)</span>
      </button>
      <input
        type="file"
        id={id("files")}
        multiple
        accept="image/*,application/pdf,.pdf"
        hidden
        data-file-input
      />
      <ul class="file-list" data-file-list hidden></ul>
      <p class="field-error" id={id("files-error")} data-file-error hidden></p>
      <span class="sr-only" aria-live="polite" data-file-live></span>
      <input type="hidden" name="attachments" value="" />
    </div>
  )}

  {/* Honeypot — humans never see or fill this */}
  <div class="hp-field" aria-hidden="true">
    <label for={id("company-website")}>Company website</label>
    <input
      type="text"
      id={id("company-website")}
      name="companyWebsite"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  {/* Attribution — populated client-side from session storage */}
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="fbclid" value="" />
  <input type="hidden" name="landing_page" value="" />
  <input type="hidden" name="referrer" value="" />
  <input type="hidden" name="page_url" value="" />
  <input type="hidden" name="submitted_at" value="" />
  <input type="hidden" name="form_variant" value={variant} />

  {/*
    Cloudflare Turnstile placeholder. When going live:
    1. Add TURNSTILE_SITE_KEY to the environment
    2. Render the widget here (see docs/SECURITY notes in README)
  */}

  <button
    type="submit"
    class="btn btn--primary lead-form-submit"
    data-event="cta_click"
    data-event-label={`lead-form-${variant}`}
  >
    Get My Free Consultation
  </button>

  <p class="form-promise">
    Free and no obligation. Detailed bid within 48 hours of your walkthrough.
  </p>

  <p class="form-consent">
    By submitting this form, you agree that Utah County Basement Pros may
    contact you by phone, text, or email regarding your project. Message and
    data rates may apply. We don't add you to marketing lists.
  </p>
</form>

<style>
  .form-promise {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
  }
  /* The form keeps its own colours even when it sits inside a dark
     section, otherwise .section--dark rules bleed soft-white text onto
     the form's own soft-white surface. */
  .lead-form,
  .lead-form p,
  .lead-form .lead-form-heading {
    color: var(--color-text);
  }
  .lead-form .form-consent,
  .lead-form label {
    color: var(--color-text-muted);
  }
  .lead-form .form-consent {
    margin: var(--space-2) 0 0;
  }

  .lead-form {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  @media (min-width: 768px) {
    .lead-form {
      padding: var(--space-6);
    }
  }

  /* Two fields per row, so the whole form fits one phone screen */
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-3);
  }
  .field-row .field {
    min-width: 0;
  }
  @media (max-width: 339px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }

  /* Tighter than the site-wide field styles. Inputs stay 46px tall
     (comfortable tap targets) and inherit the 17px body size, which keeps
     iOS from zooming in when a field is tapped. */
  .lead-form .field {
    gap: 0.2rem;
    margin-bottom: var(--space-3);
  }
  .lead-form .field label {
    margin-bottom: 0;
  }
  .lead-form .field-error {
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .lead-form .field input,
  .lead-form .field select {
    min-height: 46px;
    padding: 0.6rem 0.75rem;
  }
  .lead-form .field textarea {
    min-height: 5.5rem;
    padding: 0.6rem 0.75rem;
  }

  /* Contact page: optional qualifying questions, folded away */
  .form-more {
    margin-bottom: var(--space-3);
    border-block: 1px solid var(--color-border);
  }
  .form-more summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 46px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .form-more summary::-webkit-details-marker {
    display: none;
  }
  .form-more summary::before {
    content: "+";
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    font-weight: 400;
    line-height: 1;
  }
  .form-more[open] summary::before {
    content: "\2212";
  }
  .form-more[open] summary {
    margin-bottom: var(--space-3);
  }
  .form-more .optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  /* Optional photos / plan set */
  .file-pick {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 46px;
    padding: 0.6rem 0.75rem;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px dashed var(--color-input-border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .file-pick:hover {
    border-color: var(--color-text-muted);
  }
  .file-pick:focus-visible {
    outline: none;
    border-color: var(--brand-sea-glass);
    box-shadow: 0 0 0 3px rgb(var(--rgb-accent) / 0.45);
  }
  .file-pick svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .file-pick .optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .file-list {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }
  /* Rows are built in the browser, so they need :global() */
  .file-list :global(.file-item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    grid-template-areas: "name remove" "meta remove";
    align-items: center;
    column-gap: var(--space-2);
    padding: 0.3rem 0 0.3rem var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.35;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
  }
  .file-list :global(.file-name) {
    grid-area: name;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-list :global(.file-meta) {
    grid-area: meta;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .file-list :global(.file-item[data-state="error"] .file-meta) {
    color: var(--color-error);
  }
  .file-list :global(.file-remove) {
    grid-area: remove;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-text-muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .file-list :global(.file-remove:hover) {
    color: var(--color-text);
  }

  .lead-form-heading {
    /* Sized as a card heading, not a section heading */
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .lead-form-submit {
    width: 100%;
    margin-block: var(--space-1) 0;
  }

  .form-status {
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .form-status[data-tone="info"] {
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }
  .form-status[data-tone="error"] {
    background: #f7e6e1;
    color: var(--color-error);
  }
</style>

<script>
  import { getAttribution, track } from "@/scripts/analytics";
  import { setupLeadUploads } from "@/scripts/lead-uploads";

  document
    .querySelectorAll<HTMLFormElement>("[data-lead-form]")
    .forEach((form) => {
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const isStagingForm = form.dataset.staging === "true";
      const fileField = form.querySelector<HTMLElement>("[data-file-field]");
      const uploads =
        fileField && !isStagingForm ? setupLeadUploads(fileField) : null;
      const submitButton = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      let started = false;

      const showStatus = (message: string, tone: "info" | "error") => {
        if (!status) return;
        status.textContent = message;
        status.dataset.tone = tone;
        status.hidden = false;
      };

      // form_start: first interaction with any field
      form.addEventListener(
        "focusin",
        () => {
          if (started) return;
          started = true;
          track("form_start", { variant: form.dataset.variant ?? "" });
        },
        { once: false },
      );

      const setFieldError = (
        input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
        message: string,
      ) => {
        const errorEl = form.querySelector<HTMLElement>(
          `[data-error-for="${input.id}"]`,
        );
        if (message) {
          input.setAttribute("aria-invalid", "true");
          if (errorEl) {
            errorEl.textContent = message;
            errorEl.hidden = false;
            input.setAttribute("aria-describedby", errorEl.id || "");
          }
        } else {
          input.removeAttribute("aria-invalid");
          if (errorEl) {
            errorEl.textContent = "";
            errorEl.hidden = true;
          }
        }
      };

      const validate = (): boolean => {
        let firstInvalid:
          | HTMLInputElement
          | HTMLSelectElement
          | HTMLTextAreaElement
          | null = null;

        form
          .querySelectorAll<
            HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
          >("[required]")
          .forEach((input) => {
            if (input.validity.valid) {
              setFieldError(input, "");
            } else {
              setFieldError(
                input,
                input.dataset.errorMessage ?? "This field is required.",
              );
              firstInvalid ??= input;
            }
          });

        if (firstInvalid) {
          (firstInvalid as HTMLElement).focus();
          showStatus(
            "A few fields need attention. See the highlighted items below.",
            "error",
          );
          track("form_error", { variant: form.dataset.variant ?? "" });
          return false;
        }
        return true;
      };

      // Clear errors as the user fixes fields
      form.addEventListener("input", (e) => {
        const input = e.target as HTMLInputElement;
        if (input.required && input.validity.valid) setFieldError(input, "");
      });

      form.addEventListener("submit", (e) => {
        if (!validate()) {
          e.preventDefault();
          return;
        }

        // Files still uploading: hold the submit and send it the moment
        // they finish (any that failed are simply left off)
        if (uploads?.busy()) {
          e.preventDefault();
          const label = submitButton?.textContent ?? "";
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = "Finishing your upload…";
          }
          showStatus("Finishing your upload. One moment…", "info");
          void uploads.settled().then(() => {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = label;
            }
            if (typeof form.requestSubmit === "function") form.requestSubmit();
            else submitButton?.click();
          });
          return;
        }

        // Fill hidden attribution fields
        const attribution = getAttribution();
        const setHidden = (name: string, value: string) => {
          const field = form.querySelector<HTMLInputElement>(
            `input[type="hidden"][name="${name}"]`,
          );
          if (field) field.value = value;
        };
        for (const [key, value] of Object.entries(attribution)) {
          setHidden(key, value ?? "");
        }
        setHidden("page_url", window.location.href);
        setHidden("submitted_at", new Date().toISOString());
        setHidden("attachments", uploads?.serialize() ?? "");

        if (isStagingForm) {
          // Staging: never POST. Log a mock payload locally and tell the user.
          e.preventDefault();
          if (import.meta.env.DEV) {
            const payload = Object.fromEntries(new FormData(form).entries());
            console.info("[staging] mock lead payload:", payload);
          }
          showStatus(
            "Online requests aren't live quite yet. Please call (801) 901-8349 or email office@utahcountybasementpros.com and we'll take good care of you.",
            "info",
          );
          status?.scrollIntoView({ block: "nearest" });
          return;
        }

        track("generate_lead", { variant: form.dataset.variant ?? "" });
        // Live: allow the normal POST to /api/contact, which redirects
        // to /thank-you/ on success.
      });
    });
</script>
