---
/**
 * Site header with sticky behavior, desktop nav, and an accessible mobile
 * menu built on <details>/<summary> so it works without JavaScript.
 */
import { business } from "@/config/business";
import { headerNav } from "@/config/navigation";

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label={`${business.publicName} home`}>
      <span class="wordmark-sub"><span>Utah County</span></span>
      <span class="wordmark-name">Basement <span class="wm-pros">Pros</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul>
        {headerNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a
        class="header-phone"
        href={business.phoneHref}
        data-event="click_to_call"
        data-event-label="header"
      >
        {business.phoneDisplay}
      </a>
      <a
        class="btn btn--outline header-cta"
        href="/contact/"
        data-event="cta_click"
        data-event-label="header"
      >
        Request a Consultation
      </a>

      <details class="mobile-nav" data-mobile-nav>
        <summary aria-label="Menu">
          <span class="burger" aria-hidden="true"><span></span></span>
          <span class="burger-label">Menu</span>
        </summary>
        <nav class="mobile-nav-panel" aria-label="Mobile">
          <ul>
            {headerNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="mobile-nav-cta">
              <a
                class="btn btn--primary"
                href="/contact/"
                data-event="cta_click"
                data-event-label="mobile-nav"
              >
                Request a Consultation
              </a>
            </li>
            <li class="mobile-nav-phone">
              <a
                href={business.phoneHref}
                data-event="click_to_call"
                data-event-label="mobile-nav"
              >
                Call {business.phoneDisplay}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  /* Two-tier lockup, read top to bottom as the full name: a small
     tracked "UTAH COUNTY" between Sea Glass hairlines, over a large
     "BASEMENT PROS". Mirrors public/brand/logo.png (npm run icons). */
  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: var(--color-logo, var(--color-ink-soft));
    line-height: 1.1;
    gap: 0.3rem;
  }
  .wordmark-name {
    font-family: var(--font-display);
    /* Scales down so the name holds one line at phone widths */
    font-size: clamp(1rem, 0.86rem + 1vw, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    /* Letter-spacing adds a trailing space after the last letter. The
       negative margin removes it from the box so centering is optical
       rather than a half-space off. */
    margin-right: -0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .wordmark-sub {
    /* Stretches to the name's width so the hairlines fill the gap */
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-display);
    font-size: clamp(0.56rem, 0.48rem + 0.5vw, 0.66rem);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .wordmark-sub span {
    /* Balances the trailing letter-space so the text sits dead center */
    padding-left: 0.42em;
  }
  .wordmark-sub::before,
  .wordmark-sub::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--brand-sea-glass);
  }

  /* THEME PREVIEW: bold logo from Hunting's mockup. Heavy soft serif
     (Fraunces at full SOFT, Cooper-style), "PROS" outlined. */
  :global(:root[data-logo="bold"]) .wordmark {
    gap: 0.12rem;
  }
  :global(:root[data-logo="bold"]) .wordmark-name,
  :global(:root[data-logo="bold"]) .wordmark-sub {
    font-family: "Fraunces Variable", "Cooper Black", Georgia, serif;
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 0, "opsz" 9; /* chunky, Cooper-style */
    letter-spacing: 0.01em;
    line-height: 1;
  }
  :global(:root[data-logo="bold"]) .wordmark-name {
    font-size: clamp(1.2rem, 1.02rem + 1vw, 1.5rem);
    margin-right: 0;
  }
  :global(:root[data-logo="bold"]) .wordmark-sub {
    justify-content: center;
    color: inherit;
    font-size: clamp(0.82rem, 0.7rem + 0.68vw, 1.02rem);
    /* Wider than the name, as in the mockup */
    letter-spacing: 0.1em;
  }
  :global(:root[data-logo="bold"]) .wordmark-sub span {
    padding-left: 0.1em;
  }
  :global(:root[data-logo="bold"]) .wordmark-sub::before,
  :global(:root[data-logo="bold"]) .wordmark-sub::after {
    display: none;
  }
  /* Stroke is painted under the fill, so only its outer half shows:
     a clean outline with the letter interior in the header colour. */
  :global(:root[data-logo="bold"]) .wm-pros {
    color: var(--color-bg);
    -webkit-text-stroke: max(2.4px, 0.09em) var(--color-logo, var(--color-ink-soft));
    paint-order: stroke fill;
  }

  .desktop-nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: var(--space-2) 0;
    border-bottom: 1px solid transparent;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent-secondary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .header-phone {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .header-phone:hover {
    color: var(--color-text-muted);
  }
  .header-cta {
    min-height: 42px;
    padding: 0.65rem 1.4rem;
  }

  /* ---- Mobile nav (details/summary; works without JS) ---- */
  .mobile-nav {
    display: none;
    position: relative;
  }
  .mobile-nav summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    min-height: 44px;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .burger {
    position: relative;
    width: 18px;
    height: 12px;
    display: inline-block;
  }
  .burger span,
  .burger::before,
  .burger::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
  }
  .burger::before {
    top: 0;
  }
  .burger span {
    top: 5px;
  }
  .burger::after {
    bottom: 0;
  }
  .mobile-nav[open] .burger::before {
    top: 5px;
    transform: rotate(45deg);
  }
  .mobile-nav[open] .burger span {
    opacity: 0;
  }
  .mobile-nav[open] .burger::after {
    bottom: 5px;
    transform: rotate(-45deg);
  }

  .mobile-nav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 16rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-4);
  }
  .mobile-nav-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav-panel li {
    margin: 0;
  }
  .mobile-nav-panel a:not(.btn) {
    display: block;
    padding: var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--radius);
  }
  .mobile-nav-panel a:not(.btn):hover,
  .mobile-nav-panel a[aria-current="page"]:not(.btn) {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }
  .mobile-nav-cta {
    padding: var(--space-3);
  }
  .mobile-nav-cta .btn {
    width: 100%;
  }
  .mobile-nav-phone {
    text-align: center;
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 1023px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
  /* Below this the wordmark, phone, and Menu button start fighting for
     space and the wordmark is forced to wrap. The sticky bottom bar
     already carries a tap-to-call button on mobile, so the header phone
     is redundant here. */
  @media (max-width: 559px) {
    .header-phone {
      display: none;
    }
  }
</style>

<script>
  // Shadow under the sticky header once the page scrolls.
  const header = document.querySelector("[data-header]");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) header.setAttribute("data-scrolled", "");
    else header.removeAttribute("data-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile nav: close on link click, outside click, and Escape.
  const nav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
  if (nav) {
    nav.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) nav.removeAttribute("open");
    });
    document.addEventListener("click", (e) => {
      if (nav.hasAttribute("open") && !nav.contains(e.target as Node)) {
        nav.removeAttribute("open");
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.hasAttribute("open")) {
        nav.removeAttribute("open");
        nav.querySelector("summary")?.focus();
      }
    });
  }
</script>
