---
/**
 * Owner story block. Home variant: condensed intro to Hunting, with Gary
 * credited as the advisor who reviews every project (never as an owner).
 * About variant: full bios with both photos.
 */
import { Image } from "astro:assets";
import familyPhoto from "@/assets/family/hunting-tanner-family.jpg";
import garyPhoto from "@/assets/family/gary-tanner.jpg";

interface Props {
  variant?: "home" | "about";
}

const { variant = "home" } = Astro.props;
---

{variant === "home" ? (
  <div class="owner-story">
    <div class="owner-media">
      <Image
        src={familyPhoto}
        alt="Hunting Tanner with his wife and son"
        width={720}
        height={1013}
        loading="lazy"
        class="owner-photo"
      />
    </div>

    <div class="owner-copy">
      <span class="eyebrow">Meet the Owner</span>
      <h2>Three generations of building experience</h2>
      <p>
        Hunting Tanner is a third-generation contractor who grew up on job
        sites alongside his dad, Gary, who serves as senior advisor.
        Together they bring more than 40 years of combined construction
        experience, and both are involved in every project. That gives Utah
        County homeowners something rare: decades of construction judgment
        behind a builder who still answers the phone himself.
      </p>
      <p>
        Hunting earned his degree in Finance from BYU and runs every
        project hands-on, from the first walkthrough to the final one. He
        lives in Utah County with his wife and kids, in the same
        communities this company serves.
      </p>
      <a class="owner-link" href="/about/">Read the full story →</a>
    </div>
  </div>
) : (
  <div class="founders">
    <div class="founder">
      <div class="founder-media">
        <Image
          src={familyPhoto}
          alt="Hunting Tanner with his wife and son"
          width={720}
          height={1013}
          loading="lazy"
          class="owner-photo"
        />
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Founder</span>
        <h2>Hunting Tanner</h2>
        <p>
          Hunting is a third-generation contractor who grew up on job
          sites working alongside his dad. He earned his degree in Finance
          from BYU, combining hands-on building experience with strong
          business fundamentals.
        </p>
        <p>
          As the licensed general contractor in Utah, Hunting handles
          everything that keeps your project moving: estimates, contracts,
          scheduling, inspections, client communication, and financial
          management. He is personally involved in every single project,
          on site making sure every detail is handled and every question
          gets answered. When you hire Utah County Basement Pros, you
          get Hunting Tanner.
        </p>
      </div>
    </div>

    <div class="founder founder--reverse">
      <div class="founder-media">
        <Image
          src={garyPhoto}
          alt="Gary Tanner with his wife"
          width={720}
          height={1080}
          loading="lazy"
          class="owner-photo"
        />
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Senior Advisor</span>
        <h2>Gary Tanner</h2>
        <p>
          Gary spent more than 35 years as a licensed general contractor in
          California, specializing in tenant improvement construction. He
          owned and operated Amaron Construction, building out commercial
          spaces across the state. His technical expertise spans every
          aspect of construction, from framing and finish carpentry to
          electrical coordination and full project management.
        </p>
        <p>
          As senior advisor to Utah County Basement Pros, Gary is
          involved in every project. He reviews scopes of work before they
          reach you and stays close to the details once construction
          begins. Together with Hunting, that is more than 40 years of
          combined experience looking at your basement before a single wall
          goes up.
        </p>
      </div>
    </div>
  </div>
)}

<style>
  .owner-story {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .owner-story {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }

  .owner-media,
  .founder-media {
    max-width: 24rem;
    margin-inline: auto;
    width: 100%;
  }
  .owner-photo {
    border-radius: var(--radius-lg);
    height: auto;
    width: 100%;
  }

  .owner-link {
    font-weight: 700;
    text-decoration: none;
  }
  .owner-link:hover {
    text-decoration: underline;
  }

  .founders {
    display: grid;
    gap: var(--space-8);
  }
  .founder {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .founder {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
    .founder--reverse .founder-media {
      order: 2;
    }
    .founder--reverse .founder-copy {
      order: 1;
    }
  }
</style>
