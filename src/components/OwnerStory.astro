---
/**
 * Founders story block. Home variant: condensed intro to Hunting and Gary.
 * About variant: full bios with both photos.
 */
import { Image } from "astro:assets";
import familyPhoto from "@/assets/family/hunting-tanner-family.jpg";
import garyPhoto from "@/assets/family/gary-tanner.jpg";

interface Props {
  variant?: "home" | "about";
}

const { variant = "home" } = Astro.props;
---

{variant === "home" ? (
  <div class="owner-story">
    <div class="owner-media">
      <Image
        src={familyPhoto}
        alt="Hunting Tanner with his wife and son"
        width={720}
        height={1013}
        loading="lazy"
        class="owner-photo"
      />
    </div>

    <div class="owner-copy">
      <span class="eyebrow">Meet the Founders</span>
      <h2>Three generations of building, one family name</h2>
      <p>
        Hunting Tanner is a third-generation contractor who grew up on job
        sites working alongside his dad. He founded Hunting Tanner
        Construction with his father Gary, a general contractor with over
        30 years of experience, to give Utah County homeowners something
        rare: a builder with deep construction roots that still answers
        the phone.
      </p>
      <p>
        Hunting earned his degree in Finance from BYU and runs every
        project hands-on, from the first walkthrough to the final one. He
        lives in Utah County with his wife and kids, in the same
        communities this company serves.
      </p>
      <a class="owner-link" href="/about/">Read the full story →</a>
    </div>
  </div>
) : (
  <div class="founders">
    <div class="founder">
      <div class="founder-media">
        <Image
          src={familyPhoto}
          alt="Hunting Tanner with his wife and son"
          width={720}
          height={1013}
          loading="lazy"
          class="owner-photo"
        />
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Founder</span>
        <h2>Hunting Tanner</h2>
        <p>
          Hunting is a third-generation contractor who grew up on job
          sites working alongside his dad. He earned his degree in Finance
          from BYU, combining hands-on building experience with strong
          business fundamentals.
        </p>
        <p>
          As the licensed general contractor in Utah, Hunting handles
          everything that keeps your project moving: estimates, contracts,
          scheduling, inspections, client communication, and financial
          management. He is personally involved in every single project,
          on site making sure every detail is handled and every question
          gets answered. When you hire Hunting Tanner Construction, you
          get Hunting Tanner.
        </p>
      </div>
    </div>

    <div class="founder founder--reverse">
      <div class="founder-media">
        <Image
          src={garyPhoto}
          alt="Gary Tanner with his wife"
          width={720}
          height={1080}
          loading="lazy"
          class="owner-photo"
        />
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Co-Founder</span>
        <h2>Gary Tanner</h2>
        <p>
          Gary was a licensed general contractor in California for over 30
          years, specializing in tenant improvement construction. He owned
          and operated Amaron Construction, building out commercial spaces
          across the state. His technical expertise spans every aspect of
          construction, from framing and finish carpentry to electrical
          coordination and full project management.
        </p>
        <p>
          Known for his meticulous attention to detail, Gary personally
          reviews every scope of work and maintains quality standards on
          every job. After three decades of building strong relationships
          with top subcontractors, he's brought that same network and
          expertise to Utah.
        </p>
      </div>
    </div>
  </div>
)}

<style>
  .owner-story {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .owner-story {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }

  .owner-media,
  .founder-media {
    max-width: 24rem;
    margin-inline: auto;
    width: 100%;
  }
  .owner-photo {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    height: auto;
    width: 100%;
  }

  .owner-link {
    font-weight: 700;
    text-decoration: none;
  }
  .owner-link:hover {
    text-decoration: underline;
  }

  .founders {
    display: grid;
    gap: var(--space-8);
  }
  .founder {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .founder {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
    .founder--reverse .founder-media {
      order: 2;
    }
    .founder--reverse .founder-copy {
      order: 1;
    }
  }
</style>
