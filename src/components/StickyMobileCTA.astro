---
/** Fixed bottom CTA bar on mobile: Call + Text + Free Consultation. */
import { business } from "@/config/business";
---

<div class="sticky-cta" data-sticky-cta>
  <a
    class="sticky-cta-call"
    href={business.phoneHref}
    aria-label={`Call ${business.phoneDisplay}`}
    data-event="click_to_call"
    data-event-label="sticky-bar"
  >
    Call
  </a>
  <a
    class="sticky-cta-text"
    href={business.smsHref}
    aria-label={`Text ${business.phoneDisplay}`}
    data-event="click_to_text"
    data-event-label="sticky-bar"
  >
    Text
  </a>
  <a
    class="sticky-cta-form"
    href="/contact/#contact-form"
    data-consult-link
    data-event="cta_click"
    data-event-label="sticky-bar"
  >
    Free Consultation
  </a>
</div>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-cta {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr 1.8fr;
      gap: 1px;
      background: var(--color-line);
      border-top: 1px solid var(--color-line);
      padding-bottom: env(safe-area-inset-bottom, 0);
      transition: transform 0.2s ease;
    }
    /* Slides away while a form is on screen or being typed in, so it
       never covers fields, the keyboard, or the submit button */
    .sticky-cta[data-hidden] {
      transform: translateY(110%);
    }
    .sticky-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      font-size: var(--text-sm);
      font-weight: 700;
      text-decoration: none;
      padding: var(--space-3);
      text-align: center;
    }
    .sticky-cta-call,
    .sticky-cta-text {
      background: var(--color-background);
      color: var(--color-text);
    }
    .sticky-cta-form {
      background: var(--color-button-primary);
      color: var(--color-button-primary-text);
    }
    /* Keep page content clear of the fixed bar */
    :global(body) {
      padding-bottom: 56px;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-cta]");
  const forms = document.querySelectorAll<HTMLFormElement>("[data-lead-form]");
  if (bar && forms.length > 0 && "IntersectionObserver" in window) {
    const onScreen = new Set<Element>();
    let typing = false;
    const update = () => {
      const hide = typing || onScreen.size > 0;
      bar.toggleAttribute("data-hidden", hide);
      bar.inert = hide;
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        update();
      },
      { threshold: 0.4 },
    );
    forms.forEach((form) => {
      observer.observe(form);
      form.addEventListener("focusin", () => {
        typing = true;
        update();
      });
      form.addEventListener("focusout", () => {
        typing = false;
        update();
      });
    });
  }
</script>
