---
/**
 * Floating colour-theme switcher. Lives ONLY on the theme-preview branch,
 * so it appears on the Vercel preview URL and never on huntingtanner.com.
 *
 * Choices are applied as data attributes on <html> (see theme-preview.css
 * and the bold-logo rules in Header/Footer), remembered across pages, and
 * shareable via ?palette=forest&buttons=dark&bands=lighter&logo=bold.
 */
const palettes = [
  { id: "current", label: "Current", note: "Coastal (live now)", swatches: ["#2c3135", "#aebfbc", "#c7b9a9", "#f1ede6", "#faf8f3"] },
  { id: "walnut", label: "1 · Walnut & Linen", note: "Top pick", swatches: ["#3b302a", "#78604d", "#ab9988", "#e8ddd1", "#faf8f4"] },
  { id: "sage", label: "2 · Timber & Sage", note: "", swatches: ["#3c342f", "#765a48", "#858e7a", "#e2d8c9", "#f9f6ef"] },
  { id: "canyon", label: "3 · Canyon Clay", note: "", swatches: ["#3d2d27", "#a26d54", "#bea493", "#e7d8c6", "#fbf8f2"] },
  { id: "mocha", label: "4 · Modern Mocha", note: "", swatches: ["#2b2521", "#5b4639", "#989087", "#ddd7ce", "#f8f6f1"] },
  { id: "forest", label: "5 · Forest & Stone", note: "Favorite", swatches: ["#344b40", "#78877a", "#aeaa99", "#e7e2d8", "#faf8f3"] },
  { id: "navy", label: "6 · Heritage Navy", note: "Favorite", swatches: ["#344a59", "#71838c", "#a89a89", "#e5ded4", "#f8f6f2"] },
  { id: "burgundy", label: "7 · Burgundy & Sand", note: "", swatches: ["#623f44", "#997679", "#b5a291", "#e8dfd4", "#faf7f2"] },
];
const names = Object.fromEntries(palettes.map((p) => [p.id, p.label.replace(/^\d · /, "")]));
---

<aside class="tp" data-tp aria-label="Colour theme preview" data-names={JSON.stringify(names)}>
  <button class="tp-toggle" type="button" data-tp-toggle aria-expanded="false">
    <span class="tp-dot" aria-hidden="true"></span>
    <span data-tp-current>Color preview</span>
  </button>

  <div class="tp-panel" data-tp-panel hidden>
    <p class="tp-title">Preview colors &amp; logo</p>
    <p class="tp-sub">Only visible on this preview link. The live site is unchanged.</p>

    <fieldset>
      <legend>Logo</legend>
      <div class="tp-seg">
        <label><input type="radio" name="tp-logo" value="classic" /><span>Classic</span></label>
        <label><input type="radio" name="tp-logo" value="bold" /><span class="tp-bold-sample">Bold</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Palette</legend>
      {palettes.map((p) => (
        <label class="tp-option">
          <input type="radio" name="tp-palette" value={p.id} />
          <span class="tp-option-text">
            <span class="tp-option-name">
              {p.label}
              {p.note && <span class="tp-option-note">{p.note}</span>}
            </span>
            <span class="tp-swatches" aria-hidden="true">
              {p.swatches.map((c) => <span style={`background:${c}`}></span>)}
            </span>
          </span>
        </label>
      ))}
    </fieldset>

    <fieldset>
      <legend>Main buttons</legend>
      <div class="tp-seg">
        <label><input type="radio" name="tp-buttons" value="light" /><span>Light</span></label>
        <label><input type="radio" name="tp-buttons" value="dark" /><span>Dark</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Section bands</legend>
      <div class="tp-seg">
        <label><input type="radio" name="tp-bands" value="standard" /><span>Standard</span></label>
        <label><input type="radio" name="tp-bands" value="lighter" /><span>Lighter</span></label>
      </div>
    </fieldset>

    <button class="tp-copy" type="button" data-tp-copy>Copy link to this option</button>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>("[data-tp]")!;
  const toggle = el.querySelector<HTMLButtonElement>("[data-tp-toggle]")!;
  const panel = el.querySelector<HTMLElement>("[data-tp-panel]")!;
  const current = el.querySelector<HTMLElement>("[data-tp-current]")!;
  const copy = el.querySelector<HTMLButtonElement>("[data-tp-copy]")!;
  const names: Record<string, string> = JSON.parse(el.dataset.names || "{}");

  // Each control maps to a data attribute on <html> and a remembered value
  const controls = {
    palette: "current",
    buttons: "light",
    bands: "standard",
    logo: "classic",
  } as const;
  type Key = keyof typeof controls;

  const store = (k: string, v: string) => { try { localStorage.setItem(`tp-${k}`, v); } catch {} };
  const value = (k: Key) => root.dataset[k] || controls[k];

  const sync = () => {
    (Object.keys(controls) as Key[]).forEach((k) => {
      el.querySelectorAll<HTMLInputElement>(`input[name="tp-${k}"]`).forEach((i) => (i.checked = i.value === value(k)));
    });
    const extras = [
      value("logo") === "bold" ? "bold logo" : "",
      `${value("buttons")} buttons`,
      value("bands") === "lighter" ? "lighter bands" : "",
    ].filter(Boolean);
    current.textContent = `${names[value("palette")] ?? value("palette")} · ${extras.join(" · ")}`;
  };

  el.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    const k = t.name.replace("tp-", "") as Key;
    if (!(k in controls)) return;
    root.dataset[k] = t.value;
    store(k, t.value);
    sync();
  });

  toggle.addEventListener("click", () => {
    const open = panel.hidden;
    panel.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  });

  copy.addEventListener("click", async () => {
    const url = new URL(location.href);
    (Object.keys(controls) as Key[]).forEach((k) => url.searchParams.set(k, value(k)));
    try {
      await navigator.clipboard.writeText(url.toString());
      copy.textContent = "Link copied";
    } catch {
      copy.textContent = url.toString();
    }
    setTimeout(() => (copy.textContent = "Copy link to this option"), 2500);
  });

  sync();
</script>

<style>
  /* The switcher keeps fixed neutral colours so it reads the same on
     every palette and never gets mistaken for part of the design. */
  .tp {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 60;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    color: #1d1d1f;
  }
  @media (max-width: 767px) {
    /* Sit above the sticky Call / Request Consultation bar */
    .tp {
      bottom: calc(56px + 12px + env(safe-area-inset-bottom, 0px));
      left: 12px;
      right: 12px;
    }
  }
  .tp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 999px;
    background: #ffffff;
    color: #1d1d1f;
    font: inherit;
    font-weight: 600;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
    cursor: pointer;
    text-align: left;
  }
  .tp-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: conic-gradient(#3b302a, #a26d54, #344b40, #344a59, #623f44, #aebfbc, #3b302a);
  }
  .tp-panel {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: 8px;
    width: min(340px, 100%);
    max-height: min(78vh, 680px);
    overflow: auto;
    padding: 14px;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.25);
  }
  .tp-panel[hidden] {
    display: none;
  }
  .tp-title {
    margin: 0;
    font-weight: 700;
    font-size: 15px;
  }
  .tp-sub {
    margin: 2px 0 12px;
    color: #5a5a5f;
    font-size: 12px;
    line-height: 1.4;
  }
  .tp fieldset {
    border: 0;
    margin: 0 0 12px;
    padding: 0;
  }
  .tp legend {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5a5a5f;
    margin-bottom: 6px;
  }
  .tp-option {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border: 1px solid #e3e3e6;
    border-radius: 8px;
    margin-bottom: 5px;
    cursor: pointer;
  }
  .tp-option:has(input:checked) {
    border-color: #1d1d1f;
    background: #f5f5f7;
  }
  .tp-option-text {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }
  .tp-option-name {
    display: grid;
    font-weight: 600;
    line-height: 1.25;
  }
  .tp-option-note {
    font-size: 11px;
    font-weight: 500;
    color: #5a5a5f;
  }
  .tp-swatches {
    display: flex;
    flex-shrink: 0;
  }
  .tp-swatches span {
    width: 14px;
    height: 22px;
    border: 1px solid rgb(0 0 0 / 0.06);
  }
  .tp-seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .tp-seg label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    border: 1px solid #e3e3e6;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }
  .tp-seg label:has(input:checked) {
    border-color: #1d1d1f;
    background: #f5f5f7;
  }
  .tp-bold-sample {
    font-family: "Fraunces Variable", Georgia, serif;
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 0;
    font-size: 15px;
  }
  .tp-copy {
    width: 100%;
    min-height: 40px;
    border: 0;
    border-radius: 8px;
    background: #1d1d1f;
    color: #ffffff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    word-break: break-all;
  }
</style>
