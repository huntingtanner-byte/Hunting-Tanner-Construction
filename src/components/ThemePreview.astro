---
/**
 * Floating colour-theme switcher. Lives ONLY on the theme-preview branch,
 * so it appears on the Vercel preview URL and never on huntingtanner.com.
 *
 * Choice is applied as data attributes on <html> (see theme-preview.css),
 * remembered across pages, and can be shared via ?palette=walnut&buttons=dark.
 */
const palettes = [
  { id: "current", label: "Current", note: "Coastal: Sea Glass & Charcoal", swatches: ["#2c3135", "#aebfbc", "#c7b9a9", "#faf8f3"] },
  { id: "walnut", label: "Walnut & Linen", note: "Option 1", swatches: ["#3b302a", "#78604d", "#ab9988", "#e8ddd1", "#faf8f4"] },
  { id: "sage", label: "Timber & Sage", note: "Option 2", swatches: ["#3c342f", "#765a48", "#858e7a", "#e2d8c9", "#f9f6ef"] },
];
---

<aside class="tp" data-tp aria-label="Colour theme preview">
  <button class="tp-toggle" type="button" data-tp-toggle aria-expanded="false">
    <span class="tp-dot" aria-hidden="true"></span>
    <span data-tp-current>Color preview</span>
  </button>

  <div class="tp-panel" data-tp-panel hidden>
    <p class="tp-title">Preview colors</p>
    <p class="tp-sub">Only visible on this preview link. The live site is unchanged.</p>

    <fieldset>
      <legend>Palette</legend>
      {palettes.map((p) => (
        <label class="tp-option">
          <input type="radio" name="tp-palette" value={p.id} />
          <span class="tp-option-text">
            <span class="tp-option-name">{p.label}</span>
            <span class="tp-option-note">{p.note}</span>
            <span class="tp-swatches" aria-hidden="true">
              {p.swatches.map((c) => <span style={`background:${c}`}></span>)}
            </span>
          </span>
        </label>
      ))}
    </fieldset>

    <fieldset>
      <legend>Main buttons</legend>
      <div class="tp-seg">
        <label><input type="radio" name="tp-buttons" value="light" /><span>Light</span></label>
        <label><input type="radio" name="tp-buttons" value="dark" /><span>Dark</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Section bands</legend>
      <div class="tp-seg">
        <label><input type="radio" name="tp-bands" value="standard" /><span>Standard</span></label>
        <label><input type="radio" name="tp-bands" value="lighter" /><span>Lighter</span></label>
      </div>
    </fieldset>

    <button class="tp-copy" type="button" data-tp-copy>Copy link to this option</button>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>("[data-tp]")!;
  const toggle = el.querySelector<HTMLButtonElement>("[data-tp-toggle]")!;
  const panel = el.querySelector<HTMLElement>("[data-tp-panel]")!;
  const current = el.querySelector<HTMLElement>("[data-tp-current]")!;
  const copy = el.querySelector<HTMLButtonElement>("[data-tp-copy]")!;
  const names: Record<string, string> = { current: "Current", walnut: "Walnut & Linen", sage: "Timber & Sage" };

  const store = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
  const sync = () => {
    const p = root.dataset.palette || "current";
    const b = root.dataset.buttons || "light";
    const s = root.dataset.bands || "standard";
    el.querySelectorAll<HTMLInputElement>('input[name="tp-palette"]').forEach((i) => (i.checked = i.value === p));
    el.querySelectorAll<HTMLInputElement>('input[name="tp-buttons"]').forEach((i) => (i.checked = i.value === b));
    el.querySelectorAll<HTMLInputElement>('input[name="tp-bands"]').forEach((i) => (i.checked = i.value === s));
    current.textContent = `${names[p] ?? p} · ${b} buttons${s === "lighter" ? " · lighter bands" : ""}`;
  };

  el.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "tp-palette") { root.dataset.palette = t.value; store("tp-palette", t.value); }
    if (t.name === "tp-buttons") { root.dataset.buttons = t.value; store("tp-buttons", t.value); }
    if (t.name === "tp-bands") { root.dataset.bands = t.value; store("tp-bands", t.value); }
    sync();
  });

  toggle.addEventListener("click", () => {
    const open = panel.hidden;
    panel.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  });

  copy.addEventListener("click", async () => {
    const url = new URL(location.href);
    url.searchParams.set("palette", root.dataset.palette || "current");
    url.searchParams.set("buttons", root.dataset.buttons || "light");
    url.searchParams.set("bands", root.dataset.bands || "standard");
    try {
      await navigator.clipboard.writeText(url.toString());
      copy.textContent = "Link copied";
    } catch {
      copy.textContent = url.toString();
    }
    setTimeout(() => (copy.textContent = "Copy link to this option"), 2500);
  });

  sync();
</script>

<style>
  /* The switcher keeps fixed neutral colours so it reads the same on
     every palette and never gets mistaken for part of the design. */
  .tp {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 60;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    color: #1d1d1f;
  }
  @media (max-width: 767px) {
    /* Sit above the sticky Call / Request Consultation bar */
    .tp {
      bottom: calc(56px + 12px + env(safe-area-inset-bottom, 0px));
      left: 12px;
      right: 12px;
    }
  }
  .tp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 999px;
    background: #ffffff;
    color: #1d1d1f;
    font: inherit;
    font-weight: 600;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
    cursor: pointer;
  }
  .tp-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: conic-gradient(#3b302a, #ab9988, #858e7a, #aebfbc, #3b302a);
  }
  .tp-panel {
    margin-bottom: 8px;
    width: min(320px, 100%);
    max-height: 70vh;
    overflow: auto;
    padding: 16px;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.25);
    position: absolute;
    bottom: 100%;
    left: 0;
  }
  .tp-panel[hidden] {
    display: none;
  }
  .tp-title {
    margin: 0;
    font-weight: 700;
    font-size: 15px;
  }
  .tp-sub {
    margin: 2px 0 12px;
    color: #5a5a5f;
    font-size: 12px;
    line-height: 1.4;
  }
  .tp fieldset {
    border: 0;
    margin: 0 0 12px;
    padding: 0;
  }
  .tp legend {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5a5a5f;
    margin-bottom: 6px;
  }
  .tp-option {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 10px;
    border: 1px solid #e3e3e6;
    border-radius: 8px;
    margin-bottom: 6px;
    cursor: pointer;
  }
  .tp-option:has(input:checked) {
    border-color: #1d1d1f;
    background: #f5f5f7;
  }
  .tp-option input {
    margin-top: 3px;
  }
  .tp-option-text {
    display: grid;
    gap: 2px;
  }
  .tp-option-name {
    font-weight: 600;
  }
  .tp-option-note {
    font-size: 12px;
    color: #5a5a5f;
  }
  .tp-swatches {
    display: flex;
    margin-top: 4px;
  }
  .tp-swatches span {
    width: 22px;
    height: 14px;
    border: 1px solid rgb(0 0 0 / 0.08);
  }
  .tp-seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .tp-seg label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    border: 1px solid #e3e3e6;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }
  .tp-seg label:has(input:checked) {
    border-color: #1d1d1f;
    background: #f5f5f7;
  }
  .tp-copy {
    width: 100%;
    min-height: 40px;
    border: 0;
    border-radius: 8px;
    background: #1d1d1f;
    color: #ffffff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    word-break: break-all;
  }
</style>
