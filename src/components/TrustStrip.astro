---
/**
 * Concrete-principle trust strip. "Licensed and insured" appears only when
 * canClaimLicensed is true — never before the license is issued.
 */
import { canClaimLicensed } from "@/config/business";

/**
 * Kept to exactly four items so the strip stays balanced on the 4-column
 * grid: once licensed, that credential leads and displaces the
 * locally-owned line, which the footer and service-area pages already make.
 */
const principles = [
  ...(canClaimLicensed
    ? [
        {
          title: "Licensed & insured",
          detail:
            "A licensed Utah general contractor carrying appropriate insurance.",
        },
      ]
    : []),
  {
    title: "35+ years of experience behind every job",
    detail:
      "Hunting's father Gary, a general contractor with over 35 years in the industry, is our senior advisor and involved in every project.",
  },
  {
    title: "An owner on every project",
    detail:
      "Hunting is personally involved in every single job, start to finish.",
  },
  {
    title: "Organized scopes & planning",
    detail: "Written scopes and change orders. Nothing lives in someone's head.",
  },
  ...(canClaimLicensed
    ? []
    : [
        {
          title: "Locally owned in Utah County",
          detail:
            "A local owner who answers the phone and stands behind the work.",
        },
      ]),
];
---

<div class="trust-strip">
  <div class="container">
    <ul class="trust-list">
      {principles.map((p) => (
        <li>
          <strong>{p.title}</strong>
          <span>{p.detail}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Light band, not a dark one — dark is reserved for the closing CTA and
     the footer so the page stays airy. Separated by hairlines only. */
  .trust-strip {
    background: var(--color-background);
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-7);
  }
  .trust-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 640px) {
    .trust-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .trust-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .trust-list li {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    /* A short Sea Glass rule above each item — the accent used quietly */
    border-top: 2px solid var(--brand-sea-glass);
  }
  .trust-list strong {
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-lg);
    letter-spacing: -0.005em;
  }
  .trust-list span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
</style>
