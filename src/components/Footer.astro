---
import { business, canClaimLicensed, activeSocialLinks } from "@/config/business";
import { footerServices, footerAreas, footerCompany } from "@/config/navigation";

const year = new Date().getFullYear();

const socialLabels: Record<string, string> = {
  instagram: "Instagram",
  facebook: "Facebook",
  tiktok: "TikTok",
  youtube: "YouTube",
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-wordmark">
          Hunting Tanner<br /><span>Construction</span>
        </p>
        <p class="footer-tagline">
          A Utah County–based residential contractor serving homeowners at
          their properties. Serving Saratoga Springs, Lehi, and communities
          throughout Utah County, plus Herriman.
        </p>
        <p class="footer-contact">
          <a
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="footer"
          >{business.phoneDisplay}</a>
          <br />
          <a
            href={business.emailHref}
            data-event="click_to_email"
            data-event-label="footer"
          >{business.email}</a>
        </p>
        {activeSocialLinks.length > 0 && (
          <ul class="footer-social">
            {activeSocialLinks.map(({ network, url }) => (
              <li>
                <a
                  href={url}
                  rel="noopener"
                  data-event="social_click"
                  data-event-label={network}
                >
                  {socialLabels[network] ?? network}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav aria-label="Services">
        <h2 class="footer-heading">Services</h2>
        <ul>
          {footerServices.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Service areas">
        <h2 class="footer-heading">Service Areas</h2>
        <ul>
          {footerAreas.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="footer-heading">Company</h2>
        <ul>
          {footerCompany.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-legal">
      <p>
        &copy; {year} {business.legalName}. All rights reserved.
        {canClaimLicensed && (
          <span> Utah Contractor License #{business.licenseNumber}.</span>
        )}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: var(--color-dark-text);
    padding-block: var(--space-8) var(--space-6);
    /* Leave room for the sticky mobile CTA bar */
    margin-bottom: 0;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .footer-wordmark span {
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    color: var(--color-dark-muted);
  }

  .footer-tagline {
    color: var(--color-dark-muted);
    font-size: var(--text-sm);
    max-width: 26rem;
  }

  .footer-contact a {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    line-height: 2;
  }
  .footer-contact a:hover {
    color: #d9a578;
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }
  .footer-social a {
    color: var(--color-dark-muted);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d9a578;
    margin-bottom: var(--space-4);
  }

  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer nav li {
    margin-bottom: var(--space-2);
  }
  .site-footer nav a {
    color: var(--color-dark-text);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .site-footer nav a:hover {
    color: #d9a578;
    text-decoration: underline;
  }

  .footer-legal {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--text-xs);
    color: var(--color-dark-muted);
  }
</style>
