---
import { business, canClaimLicensed, activeSocialLinks } from "@/config/business";
import { footerServices, footerAreas, footerCompany } from "@/config/navigation";

const year = new Date().getFullYear();

const socialLabels: Record<string, string> = {
  instagram: "Instagram",
  facebook: "Facebook",
  tiktok: "TikTok",
  youtube: "YouTube",
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-wordmark">
          <span class="fw-sub"><span>Utah County</span></span>
          <span class="fw-name">Basement <span class="wm-pros">Pros</span></span>
        </p>
        <p class="footer-tagline">
          Basement finishing and remodeling for homeowners in Saratoga
          Springs, Lehi, and communities throughout Utah County and the Salt
          Lake Valley.
        </p>
        <p class="footer-contact">
          <a
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="footer"
          >{business.phoneDisplay}</a>
          <br />
          <a
            href={business.emailHref}
            data-event="click_to_email"
            data-event-label="footer"
          >{business.email}</a>
        </p>
        {canClaimLicensed && (
          <p class="footer-license">
            <span class="license-label">Utah Contractor License</span>
            <span class="license-number">#{business.licenseNumber}</span>
          </p>
        )}
        {activeSocialLinks.length > 0 && (
          <ul class="footer-social">
            {activeSocialLinks.map(({ network, url }) => (
              <li>
                <a
                  href={url}
                  rel="noopener"
                  data-event="social_click"
                  data-event-label={network}
                >
                  {socialLabels[network] ?? network}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav aria-label="Services">
        <h2 class="footer-heading">Services</h2>
        <ul>
          {footerServices.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Service areas">
        <h2 class="footer-heading">Service Areas</h2>
        <ul>
          {footerAreas.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="footer-heading">Company</h2>
        <ul>
          {footerCompany.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-legal">
      <p>
        {business.publicName} is a DBA of {business.legalName}{canClaimLicensed
          ? `, a licensed Utah general contractor (License #${business.licenseNumber})`
          : ""}.
      </p>
      <p>&copy; {year} {business.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: var(--color-dark-text);
    padding-block: var(--space-9) var(--space-7);
    /* Leave room for the sticky mobile CTA bar */
    margin-bottom: 0;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  /* Same lockup as the header, reversed out on Charcoal */
  .footer-wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .fw-name {
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    /* offset the trailing letter-space so the text centers optically */
    padding-left: 0.14em;
    color: var(--color-on-dark);
    white-space: nowrap;
  }
  .fw-sub {
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-size: 0.7rem;
    letter-spacing: 0.42em;
    color: var(--color-dark-muted);
    white-space: nowrap;
  }
  .fw-sub span {
    padding-left: 0.42em;
  }
  .fw-sub::before,
  .fw-sub::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-on-dark-accent);
    opacity: 0.6;
  }

  /* THEME PREVIEW: bold logo, reversed out on the dark footer */
  :global(:root[data-logo="bold"]) .footer-wordmark {
    gap: 0.15rem;
  }
  :global(:root[data-logo="bold"]) .fw-name,
  :global(:root[data-logo="bold"]) .fw-sub {
    font-family: "Fraunces Variable", "Cooper Black", Georgia, serif;
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 0, "opsz" 9; /* chunky, Cooper-style */
    letter-spacing: 0.01em;
    padding-left: 0;
    line-height: 1;
    color: var(--color-on-dark);
  }
  :global(:root[data-logo="bold"]) .fw-name {
    font-size: 1.6rem;
  }
  :global(:root[data-logo="bold"]) .fw-sub {
    justify-content: center;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }
  :global(:root[data-logo="bold"]) .fw-sub span {
    padding-left: 0.1em;
  }
  :global(:root[data-logo="bold"]) .fw-sub::before,
  :global(:root[data-logo="bold"]) .fw-sub::after {
    display: none;
  }
  :global(:root[data-logo="bold"]) .wm-pros {
    color: var(--color-dark);
    -webkit-text-stroke: max(2.4px, 0.09em) var(--color-on-dark);
    paint-order: stroke fill;
  }

  .footer-tagline {
    color: var(--color-dark-muted);
    font-size: var(--text-sm);
    max-width: 26rem;
  }

  .footer-contact a {
    color: var(--color-on-dark);
    font-weight: 600;
    text-decoration: none;
    line-height: 2;
  }
  .footer-contact a:hover {
    color: var(--color-accent-bright);
  }

  /* License credential badge: eucalyptus edge ties it to the trust strip */
  .footer-license {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: var(--space-5) 0 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid rgb(var(--rgb-light) / 0.16);
    border-left: 2px solid var(--color-on-dark-accent);
    border-radius: var(--radius);
  }
  .license-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-dark-muted);
  }
  .license-number {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-on-dark);
    letter-spacing: 0.01em;
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }
  .footer-social a {
    color: var(--color-dark-muted);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-on-dark-accent);
    margin-bottom: var(--space-5);
  }

  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer nav li {
    margin-bottom: 0;
  }
  /* Block links with vertical padding so each row is a comfortable tap
     target on mobile rather than a 20px sliver. */
  .site-footer nav a {
    display: block;
    padding-block: 0.5rem;
    color: var(--color-on-dark);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .site-footer nav a:hover {
    color: var(--color-accent-bright);
    text-decoration: underline;
  }

  .footer-legal {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(var(--rgb-light) / 0.14);
    font-size: var(--text-xs);
    color: var(--color-dark-muted);
  }
  .footer-legal p {
    margin: 0;
  }
  .footer-legal p + p {
    margin-top: var(--space-2);
  }
</style>
