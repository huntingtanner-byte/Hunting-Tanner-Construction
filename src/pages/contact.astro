---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import LeadForm from "@/components/LeadForm.astro";
import { breadcrumbSchema } from "@/lib/schema";
import { business, canClaimLicensed } from "@/config/business";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact/" },
];

const schemas = [breadcrumbSchema(breadcrumbs)];
---

<BaseLayout
  title="Free Basement Consultation | Utah County Basement Pros"
  description="Book a free basement consultation with Utah County Basement Pros. Detailed bid within 48 hours of your walkthrough. Call (801) 901-8349 or send the form."
  path="/contact/"
  schemas={schemas}
>
  <PageIntro
    eyebrow="Contact"
    heading="Get Your Free Basement Consultation"
    lede="The consultation and walkthrough are free, with no obligation, and you'll have a detailed bid within 48 hours of your walkthrough. Prefer to talk? Call and you'll speak with the owner or an experienced project manager."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Reach us directly</h2>
        <p class="contact-line">
          <strong>Phone</strong>
          <a
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="contact-page"
          >{business.phoneDisplay}</a>
        </p>
        <p class="contact-line">
          <strong>Email</strong>
          <a
            href={business.emailHref}
            data-event="click_to_email"
            data-event-label="contact-page"
          >{business.email}</a>
        </p>
        <p class="contact-line">
          <strong>Service area</strong>
          <span>
            Serving Saratoga Springs, Lehi, and communities throughout Utah
            County and the Salt Lake Valley. We're a service-area business.
            We come to your home.
          </span>
        </p>
        {canClaimLicensed && (
          <p class="contact-line">
            <strong>Licensed &amp; insured</strong>
            <span class="license-value">
              Utah general contractor license #{business.licenseNumber}
            </span>
          </p>
        )}

        <h2>What happens after you reach out</h2>
        <ol>
          <li>
            <strong>We talk.</strong> A free conversation about your
            basement, your goals, and rough timing.
          </li>
          <li>
            <strong>We walk the space.</strong> A free on-site walkthrough
            at your home.
          </li>
          <li>
            <strong>You get a detailed bid within 48 hours.</strong> A
            written scope and an itemized proposal, clear enough to make a
            real decision with.
          </li>
        </ol>
        <p class="contact-note">
          Prefer reading first? See
          <a href="/process/">the full process</a> or the
          <a href="/faq/">FAQ</a>.
        </p>
      </div>

      <div class="contact-form">
        <LeadForm
          formId="contact-form"
          variant="detailed"
          heading="Tell us about your project"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 5fr 7fr;
    }
  }
  .contact-line {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }
  .contact-line strong {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .contact-line a {
    font-size: var(--text-xl);
    font-weight: 700;
    text-decoration: none;
    color: var(--color-ink);
  }
  .contact-line a:hover {
    color: var(--color-text);
  }
  .license-value {
    font-weight: 650;
    color: var(--color-ink);
  }
  .contact-info h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
  }
  .contact-info h2 + .contact-line {
    margin-top: var(--space-4);
  }
  .contact-info ol li {
    margin-bottom: var(--space-3);
  }
  .contact-note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
