---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import CTASection from "@/components/CTASection.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import { breadcrumbSchema, serviceSchema } from "@/lib/schema";
import type { FAQ } from "@/data/faqs";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Basement Remodeling", path: "/basement-remodeling/" },
];

const pageFaqs: FAQ[] = [
  {
    question: "How is remodeling different from finishing?",
    answer:
      "Finishing starts from unfinished space; remodeling reworks a basement that was finished before, sometimes decades ago. Remodels often involve selective demolition, fixing what previous work got wrong, and bringing older wiring or layouts up to today's code and today's needs. The planning process is the same: walkthrough, written scope, itemized proposal.",
  },
  {
    question: "Can you fix a basement that was finished without permits?",
    answer:
      "This comes up more often than you'd think, especially in homes finished by previous owners. We'll assess what's there during the walkthrough and be straightforward about what should be corrected, what the city may require, and what it means for scope. It's almost always fixable. It just needs to be planned rather than discovered mid-project.",
  },
  {
    question: "Can you open up a choppy basement layout?",
    answer:
      "Often, yes. Many older basement finishes are a warren of small rooms. Some walls come out easily; others are load-bearing or hide plumbing and ducts. We identify which is which during planning, so the new layout is designed around reality instead of hope.",
  },
  {
    question: "We have moisture issues. Can we still remodel?",
    answer:
      "Moisture has to be addressed first. Remodeling over an unresolved water problem is throwing money away, and we'll tell you so. Depending on the cause, solutions range from grading and gutter corrections to interior mitigation. Once the source is handled, the remodel proceeds with appropriate materials for below-grade spaces.",
  },
  {
    question: "Is a partial update worth it, or should we redo everything?",
    answer:
      "It depends on what's wrong. If the bones are good (sound framing, adequate ceiling height, code-compliant wiring), targeted updates like flooring, lighting, a bathroom refresh, and paint can transform the feel for a fraction of a full remodel. We'll give you an honest read at the walkthrough, including the option that costs us less work.",
  },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  serviceSchema({
    name: "Basement Remodeling",
    description:
      "Basement remodeling for Utah County homeowners: layout changes, updated lighting and finishes, bathroom additions, and code corrections for previously finished basements.",
    path: "/basement-remodeling/",
  }),
];
---

<BaseLayout
  title="Basement Remodeling | Utah County | Hunting Tanner Construction"
  description="Remodel a dated or poorly finished basement: layout changes, updated lighting, new flooring and finishes, bathroom additions, and code corrections. Serving Saratoga Springs, Lehi, Herriman, and Utah County."
  path="/basement-remodeling/"
  pageType="service"
  schemas={schemas}
>
  <PageIntro
    eyebrow="Service"
    heading="Basement Remodeling"
    lede="Your basement is finished. It's just finished wrong. Dated, dark, chopped into odd rooms, or done without permits by a previous owner. Remodeling fixes the layout, the light, and the feel."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container container--narrow">
      <h2>When a remodel makes sense</h2>
      <p>
        Plenty of Utah County basements were finished in the 1990s and 2000s,
        or finished hastily by a previous owner, and they show it:
        fluorescent boxes for light, hollow doors, a bathroom that was never
        quite right, and a layout designed around nothing in particular.
        The space technically counts as finished. It just doesn't get used.
      </p>
      <p>
        A remodel starts with what's worth keeping. Good framing, adequate
        ceiling height, and sound mechanical systems mean your money goes to
        the changes you'll actually feel: opening the layout, modern
        lighting, better flooring, a bathroom that matches the rest of the
        house, and details like trim and built-ins that make the basement
        feel intentional.
      </p>

      <h2>Common remodel scopes</h2>
      <ul>
        <li>
          <strong>Layout corrections</strong>: removing non-structural
          walls, combining cramped rooms into a real family space
        </li>
        <li>
          <strong>Lighting overhauls</strong>: recessed lighting layouts,
          zones and dimmers, ending the single-bulb-per-room era
        </li>
        <li>
          <strong>Bathroom additions and refreshes</strong>: new baths
          where rough-ins allow, or gut-renovating an existing one
        </li>
        <li>
          <strong>Flooring, paint, doors, and trim</strong>: the finish
          package that resets the space's age
        </li>
        <li>
          <strong>Code and safety corrections</strong>: egress, smoke/CO
          detection, and wiring issues found in older or unpermitted work
        </li>
        <li>
          <strong>Feature additions</strong>: wet bars, built-ins, media
          walls, and storage systems
        </li>
      </ul>
      <p>
        Like every HTC project, a remodel gets a written scope and an
        itemized proposal before work begins, and written change orders if
        anything shifts: <a href="/process/">the same six-step process</a>
        as a full finish.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Questions</span>
      <h2>Basement remodeling FAQs</h2>
      <FAQAccordion faqs={pageFaqs} />
      <p class="more-links">
        Starting from unfinished space instead? See
        <a href="/">basement finishing</a>. Serving
        <a href="/saratoga-springs-basement-finishing/">Saratoga Springs</a>,
        <a href="/lehi-basement-finishing/">Lehi</a>,
        <a href="/herriman-basement-finishing/">Herriman</a>, and
        <a href="/utah-county-basement-finishing/">all of Utah County</a>.
      </p>
    </div>
  </section>

  <CTASection
    heading="Tired of a basement nobody uses?"
    text="Walk us through what's not working. We'll tell you what's worth keeping, what's worth changing, and what it takes."
    withForm
    formId="basement-remodeling-form"
  />
</BaseLayout>

<style>
  .more-links {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
</style>
