 *
 * Every fact here comes from a City of Saratoga Springs page or document,
 * the Utah Code, or the residential code Utah has adopted, and is linked
 * where it is used and again in the Sources list. Do not add fees,
 * timelines, or rules that are not in one of those sources: where the city
 * publishes nothing, the page says so. After re-checking the sources, update
 * `lastChecked` below and the permit-guide note in HANDOFF.md.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import CTASection from "@/components/CTASection.astro";
