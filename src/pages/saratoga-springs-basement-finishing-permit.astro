const lastChecked = { iso: "2026-11-25", display: "November 25, 2026" };

const description =
  "How to get a basement finishing permit in Saratoga Springs, Utah: what your plan must show, the city portal, fees, inspections, the code checklist, and IADU rules.";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Service Areas", path: "/utah-county-basement-finishing/" },
  {
    name: "Saratoga Springs",
    path: "/saratoga-springs-basement-finishing/",
  },
  {
