    path: "/saratoga-springs-basement-finishing-permit/",
  },
];

/** Official sources. Document Center links change when the city replaces a
 *  file, so each PDF is also reachable from the city page named beside it. */
const src = {
  basementPermit:
    "https://www.saratogasprings-ut.gov/225/Obtaining-a-Basement-Permit",
  building: "https://www.saratogasprings-ut.gov/201/Building",
  portal: "https://cityworks.saratogasprings-ut.gov/publicaccess/login",
  buildingPermit:
    "https://www.saratogasprings-ut.gov/220/Obtaining-a-Building-Permit",
  forms: "https://www.saratogasprings-ut.gov/209/Applications-Forms",
  permitFeeTable:
    "https://www.saratogasprings-ut.gov/DocumentCenter/View/19492/Building-Permit-Fee-Schedule-2026",
  feeSchedule:
    "https://www.saratogasprings-ut.gov/DocumentCenter/View/1707/Consolidated-Fee-Schedule",
  iaduFaq:
    "https://www.saratogasprings-ut.gov/1008/FAQs-for-Accessory-Units-Renting",
  aduCode:
    "https://www.saratogasprings-ut.gov/DocumentCenter/View/1389/1920-Internal-Accessory-Dwelling-Units-IADUs",
  aduRegistration:
    "https://www.saratogasprings-ut.gov/DocumentCenter/View/14038/IADU-Registration-Process",
  utahAdopted: "https://le.utah.gov/xcode/Title15A/Chapter2/15A-2-S103.html",
  utahAmendments: "https://le.utah.gov/xcode/Title15A/Chapter3/15A-3-S202.html",
  ircCh1:
    "https://codes.iccsafe.org/content/IRC2021P3/chapter-1-scope-and-administration",
};

/** The city's lines. Tagged so a tap is not counted as a call or email to us. */
const cityPhone = { display: "801-766-6507", href: "tel:+18017666507" };
const cityEmail = "BuildingApps@SaratogaSpringsCity.com";

const permitFaqs: FAQ[] = [
  {
    question: "Do I need a permit to finish my basement in Saratoga Springs?",
    answer:
      "Yes. The city's Building Department reviews plans, issues permits, and inspects basement finishes, and its basement permit page sends applications through the online Public Portal. The requirement comes from the 2021 International Residential Code, which Utah has adopted statewide. Cosmetic work alone, such as paint, carpet, tile, cabinets, and countertops, is exempt.",
  },
  {
    question: "What does Saratoga Springs want to see on a basement plan?",
    answer:
      "The city's basement permit page says the plan should show the type of each room, the dimensions of each room, the location and size of doors and windows, the location of lights, outlets, smoke detectors, and carbon monoxide detectors, the utility or mechanical room, and the electrical panel.",
  },
  {
    question: "How much does a basement permit cost in Saratoga Springs?",
    answer:
      "The city does not publish a flat basement fee. Its fee schedule sets the permit fee from the project's valuation using the International Residential Code fee table, lists plan review at 65% of the permit fee (25% for permits that do not need a complete plan review), and adds a 1% state charge. The schedule also has a footnote about a fee that prepays a future basement permit and inspections, so ask the Building Department whether that applies to your home.",
  },
  {
    question: "How tall does a basement ceiling have to be in Saratoga Springs?",
    answer:
      "The city's basement permit page lists a minimum of 7 feet from the finished floor to the finished ceiling. Under beams, girders, ducts, and other obstructions, the minimum is 6 feet 4 inches.",
  },
  {
    question: "How do I request a basement inspection in Saratoga Springs?",
    answer:
      "The city lists an inspection request line at 801-766-6507, extension 120. The Building Department is open Monday through Thursday, 7 AM to 6 PM, and Friday, 8 AM to 5 PM, with a limited number of inspections on Fridays. Approved plans and permit documents must be on site.",
  },
  {
    question: "Can I put an apartment in my Saratoga Springs basement?",
    answer:
      "Only where the city allows internal accessory dwelling units. Saratoga Springs maps each neighborhood as IADU Allowed, Prohibited, or Potential, and its registration packet says most plats recorded before October 1, 2021 are not eligible. Where allowed, the lot must be larger than 6,000 square feet, the owner must live in the home, and the unit needs a separate exterior entrance, one extra off-street parking stall, a building permit, and a $50 registration with the city.",
