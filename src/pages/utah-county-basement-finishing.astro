---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import CTASection from "@/components/CTASection.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import ServiceAreaCard from "@/components/ServiceAreaCard.astro";
import { breadcrumbSchema } from "@/lib/schema";
import { featuredAreas, nearbyCommunities } from "@/data/service-areas";
import type { FAQ } from "@/data/faqs";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Utah County", path: "/utah-county-basement-finishing/" },
];

const cityPages = featuredAreas.filter(
  (a) => a.href !== "/utah-county-basement-finishing/",
);

const countyFaqs: FAQ[] = [
  {
    question: "Do you really serve the whole county?",
    answer:
      "We serve homeowners at their properties throughout Utah County, from Lehi and Saratoga Springs in the north to Springville and Spanish Fork in the south. For projects at the edges of the county, mention your city when you reach out and we'll confirm scheduling honestly before anyone's time is wasted.",
  },
  {
    question: "Does each Utah County city have its own permit process?",
    answer:
      "Yes. Every city runs its own building department with its own submittal requirements, fees, and review timelines. That's one practical reason to work with a contractor who plans permits into the schedule rather than treating them as an afterthought. We'll cover your city's specifics during the consultation.",
  },
  {
    question: "Why do so many Utah County homes have unfinished basements?",
    answer:
      "Builders here typically include a full basement in the foundation but leave it unfinished to keep the purchase price down, which means most homeowners are sitting on several hundred square feet of pre-built, pre-paid structure. Finishing it later, to your own taste and needs, is exactly what that space was designed for.",
  },
  {
    question: "Do you work in both newer developments and older neighborhoods?",
    answer:
      "Yes. Newer areas like Vineyard and Eagle Mountain are mostly full finishes of untouched basements. Established neighborhoods in Orem, Provo, and Pleasant Grove bring more remodels: updating, correcting, and reworking basements finished decades ago. Both follow the same written-scope process.",
  },
  {
    question: "How do I know if my city is covered?",
    answer:
      "If you're in Utah County, or in Herriman just across the north county line, you're in our service area. Not sure? Call (801) 901-8349 or send the form with your city, and you'll get a straight answer.",
  },
];

const schemas = [breadcrumbSchema(breadcrumbs)];
---

<BaseLayout
  title="Utah County Basement Finishing | Hunting Tanner Construction"
  description="Basement finishing throughout Utah County: Saratoga Springs, Lehi, Eagle Mountain, American Fork, Orem, Provo, and beyond. A Utah County based contractor with written scopes and organized project management."
  path="/utah-county-basement-finishing/"
  pageType="service-area"
  schemas={schemas}
>
  <PageIntro
    eyebrow="Service Area"
    heading="Basement Finishing Throughout Utah County"
    lede="A Utah County based residential contractor serving homeowners at their properties, from the fast-growing northwest shore of Utah Lake to the established neighborhoods of Orem and Provo."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container container--narrow">
      <h2>Local, in the practical sense</h2>
      <p>
        "Local contractor" should mean something concrete: reasonable drive
        times to your project, familiarity with how homes in your area were
        built, and an owner you can reach who lives in the same county you
        do. Hunting Tanner Construction is based in Utah County and works
        where its owner lives. This isn't a franchise territory on a map.
      </p>
      <p>
        Utah County's housing stock is practically made for basement work.
        The county's construction boom means tens of thousands of newer
        homes delivered with unfinished basements, while established
        neighborhoods hold decades of basements ready for a second life.
        Whether that's a <a href="/basement-finishing/">full finish</a> or a
        <a href="/basement-remodeling/">remodel</a>, the approach is the
        same: written scope, itemized proposal, organized construction,
        clear communication.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Featured Markets</span>
      <h2>Dedicated local pages</h2>
      <div class="grid-2 county-areas">
        {cityPages.map((area) => (
          <ServiceAreaCard area={area} />
        ))}
      </div>

      <h3 class="communities-heading">More Utah County communities we serve</h3>
      <ul class="communities-list">
        {nearbyCommunities.map((city) => (
          <li>{city}</li>
        ))}
      </ul>
      <p class="communities-note">
        These communities don't have dedicated pages yet, not because we
        don't serve them, but because we'd rather write something genuinely
        useful for each one than paste the same page with a different city
        name. If you're in any of them, <a href="/contact/">reach out
        directly</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <h2>What county homeowners are building</h2>
      <p>
        The projects vary by neighborhood age, but the goals rhyme:
        bedrooms for growing families, bathrooms on builder rough-ins,
        family rooms that give everyone space, offices for the county's
        many remote workers, and gyms, theaters, and wet bars that make
        staying home the better option. The
        <a href="/services/">services overview</a> covers the full range.
      </p>

      <h2>One county, many building departments</h2>
      <p>
        Each Utah County city permits and inspects independently, with its
        own requirements and timelines. Our job is to know what your city
        needs, build it into the schedule, and keep you out of the
        paperwork. Permit coordination is a standard part of
        <a href="/process/">the HTC process</a>, not an add-on.
      </p>

      {/* EDITORIAL NOTE (not rendered): Before publishing any per-city
          permitting specifics (fees, timelines, submittal requirements),
          verify with each city's building department. See CONTENT-TODO.md. */}

      <span class="eyebrow">County Questions</span>
      <h2>Utah County basement FAQs</h2>
      <FAQAccordion faqs={countyFaqs} />
    </div>
  </section>

  <CTASection
    heading="Wherever you are in Utah County, start here"
    text="Tell us your city and what you want from your basement. You'll get a straight answer about fit, and a walkthrough if it makes sense."
  />
</BaseLayout>

<style>
  .county-areas {
    margin-top: var(--space-6);
  }
  .communities-heading {
    margin-top: var(--space-7);
  }
  .communities-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }
  .communities-list li {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
  }
  .communities-note {
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: 46rem;
  }
</style>
