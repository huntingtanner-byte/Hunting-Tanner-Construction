---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import OwnerStory from "@/components/OwnerStory.astro";
import CTASection from "@/components/CTASection.astro";
import { breadcrumbSchema } from "@/lib/schema";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "About", path: "/about/" },
];

const schemas = [breadcrumbSchema(breadcrumbs)];
---

<BaseLayout
  title="About Hunting Tanner Construction | Third-Generation Utah Contractor"
  description="Meet the founders of Hunting Tanner Construction: Hunting Tanner, a third-generation contractor with a BYU Finance degree, and Gary Tanner, a general contractor with over 30 years of experience."
  path="/about/"
  schemas={schemas}
>
  <PageIntro
    eyebrow="About"
    heading="Three generations of building, one family name"
    lede="Hunting Tanner Construction is a father-and-son company built on a simple idea: homeowners deserve deep construction experience and a contractor who actually answers the phone."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container">
      <OwnerStory variant="about" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow">
      <h2>How the company is put together</h2>
      <p>
        HTC pairs owner-level project management with qualified, specialized
        trade partners: licensed electricians and plumbers, HVAC
        professionals, drywall and finish crews. That's the same structure
        most good general contractors use. The difference is who's running
        it. Hunting is personally involved in every single project, and
        Gary personally reviews every scope of work, bringing three decades
        of subcontractor relationships and quality standards to each job.
      </p>
      <p>
        Add Hunting's finance background, and the result is a company that
        treats your budget with the same discipline it treats the
        construction schedule: written scopes, documented change orders,
        milestone-based payments, and no surprises on the final invoice.
      </p>

      <h2>What we believe a contractor owes you</h2>
      <ul>
        <li>
          <strong>A defined scope.</strong> You should know exactly what
          you're buying before you sign.
        </li>
        <li>
          <strong>Clear expectations.</strong> Schedule, payments,
          decisions, and what happens when something changes.
        </li>
        <li>
          <strong>Responsiveness.</strong> Calls and texts answered,
          questions taken seriously, concerns addressed while they're
          small.
        </li>
        <li>
          <strong>An owner who shows up.</strong> Not a rotating cast of
          project managers. The same person, on site, every project.
        </li>
        <li>
          <strong>Transparent next steps.</strong> At every stage, you know
          what's next and who's doing it.
        </li>
      </ul>

      <h2>Where we're headed</h2>
      <p>
        Today, HTC specializes in
        <a href="/basement-finishing/">basement finishing</a> and
        <a href="/basement-remodeling/">remodeling</a> across
        <a href="/utah-county-basement-finishing/">Utah County</a>, a focus
        that keeps quality high while the company earns its reputation one
        project at a time. Over time, that foundation is built to grow into
        kitchens, larger remodels, additions, and custom homes. The name on
        the truck is a family name, and the plan is to still be proud of it
        in thirty years.
      </p>
      <p>
        Curious how a project actually runs? Read
        <a href="/process/">the six-step process</a>, see
        <a href="/projects/">finished basements</a>, or
        <a href="/contact/">start a conversation</a>.
      </p>
    </div>
  </section>

  <CTASection
    heading="Talk to the people whose name is on the company"
    text="No call centers, no sales reps. Just a direct conversation about your home and whether we're the right fit for it."
    withForm
    formId="about-form"
  />
</BaseLayout>
