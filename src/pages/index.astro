---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LeadForm from "@/components/LeadForm.astro";
import TrustStrip from "@/components/TrustStrip.astro";
import BeforeAfterSlider from "@/components/BeforeAfterSlider.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import ServiceAreaCard from "@/components/ServiceAreaCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CTASection from "@/components/CTASection.astro";
import { business } from "@/config/business";
import { coreServices } from "@/data/services";
import { featuredCities, featuredCounties } from "@/data/service-areas";
import { homeFaqs } from "@/data/faqs";
import { publishableProjects } from "@/data/projects";
import GoogleReviews from "@/components/GoogleReviews.astro";
import { serviceSchema } from "@/lib/schema";
import familyPhoto from "@/assets/family/hunting-tanner-family.jpg";
import heroImage from "@/assets/hero/basement-after.png";
import beforeImg from "@/assets/hero/basement-before.png";
import afterImg from "@/assets/hero/basement-after.png";
---

<BaseLayout
  title="Utah Basement Finishing Company | Hunting Tanner Construction"
  description="Utah basement finishing specialists serving Utah County and the Salt Lake Valley. A licensed basement finishing contractor with three generations of building experience. Free consultation."
  path="/"
  includeOrgSchema
  schemas={[serviceSchema({
    name: "Basement Finishing",
    description:
      "Complete basement finishing for Utah homeowners: space planning, framing, electrical, plumbing, drywall, trim, and flooring, managed under a written scope by a licensed Utah general contractor.",
    path: "/",
  })]}
>
  {/* ============ Hero: full-bleed photography with overlaid copy ====== */}
  <section class="hero">
    <div class="hero-media">
      <Image
        src={heroImage}
        alt="Finished Utah basement with an open kitchen, island seating, and family room"
        width={2000}
        height={1500}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero-content">
      <div class="hero-copy">
        <span class="hero-eyebrow">Utah County &amp; the Salt Lake Valley</span>
        <h1>Utah Basement<br />Finishing Specialists</h1>
        <span class="rule"></span>
        <p class="hero-lede">
          A licensed Utah basement finishing company turning unfinished
          basements into bedrooms, bathrooms, and living space.
        </p>
        <div class="hero-actions">
          <a
            class="btn btn--secondary"
            href="#home-lead-form"
            data-event="cta_click"
            data-event-label="hero"
          >
            Request a Consultation
          </a>
          <a
            class="btn btn--ghost-light"
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="hero"
          >
            Call {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ============ Credibility ============ */}
  <TrustStrip />

  {/* ============ Consultation — kept high on the page for conversion === */}
  <section class="section section--alt" id="home-lead-form">
    <div class="container consult-grid">
      <div class="consult-copy">
        <span class="eyebrow">Start Here</span>
        <h2>Tell us about your basement</h2>
        <span class="rule"></span>
        <p>
          It starts with a conversation, then a walkthrough at your home.
          You'll get straight answers on what's realistic, what it costs,
          and how long it takes, in writing.
        </p>
        <p class="consult-note">
          Prefer to talk now? Call
          <a
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="consult-section"
          >{business.phoneDisplay}</a>
          and speak directly with the owner.
        </p>
      </div>
      <div class="consult-form">
        <LeadForm formId="home-form" variant="compact" />
      </div>
    </div>
  </section>

  {/* ============ What we build ============ */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">What We Build</span>
      <h2>Basement spaces designed around how you live</h2>
      <div class="grid-3 services-grid">
        {coreServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  {/* ============ Project photography ============ */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">Our Work</span>
      <h2>Basements we've finished</h2>
      <p class="lede">
        Kitchens, bathrooms, bedrooms, and big family spaces, photographed
        room by room.
      </p>
      <div class="grid-3 projects-grid">
        {publishableProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn--secondary" href="/projects/">
          View the Full Galleries
        </a>
      </div>
    </div>
  </section>

  {/* ============ Process ============ */}
  <section class="section">
    <div class="container">
      <div class="process-head">
        <span class="eyebrow">How It Works</span>
        <h2>Six clear steps from first call to final walkthrough</h2>
        <span class="rule"></span>
        <p class="lede">
          We manage the entire basement finish, from planning and permits
          through framing, mechanicals, finishes, and the final
          walkthrough. One accountable point of contact the whole way.
        </p>
      </div>

      <div class="process-preview">
        <ProcessSteps compact />
      </div>

      {/* Condensed from the old "What's Included" section; full detail
          now lives on /services/ */}
      <ul class="process-manage">
        <li>Planning &amp; written scope</li>
        <li>Permits &amp; inspections</li>
        <li>Framing, electrical &amp; plumbing</li>
        <li>Drywall, trim &amp; flooring</li>
      </ul>

      <div class="section-cta">
        <a class="btn btn--secondary" href="/process/">
          See the Full Process
        </a>
        <a class="btn btn--secondary" href="/services/#whats-included">
          What's Included
        </a>
      </div>
    </div>
  </section>

  {/* ============ Transformation ============ */}
  <section class="section">
    <div class="container">
      <div class="transform-grid">
        <div>
          <span class="eyebrow">The Transformation</span>
          <h2>From concrete and studs to the best floor in the house</h2>
          <p>
            Most Utah homes come with hundreds of unfinished square feet
            already under the roof. Finishing that space is the most
            cost-effective way to add bedrooms, a family room, or an
            office, because the structure is already paid for.
          </p>
          <p class="transform-note">
            Drag the slider to see the same room, before and after.
          </p>
        </div>
        <BeforeAfterSlider
          before={beforeImg}
          after={afterImg}
          beforeAlt="Unfinished basement with exposed framing, ductwork, and concrete floor"
          afterAlt="The same basement finished with a kitchen, island, and furnished family room"
        />
      </div>
    </div>
  </section>

  {/* ============ Why HTC + founders, merged ============ */}
  <section class="section section--alt">
    <div class="container why-grid">
      <div class="why-media">
        <Image
          src={familyPhoto}
          alt="Hunting Tanner with his wife and son"
          width={720}
          height={1013}
          loading="lazy"
          class="why-photo"
        />
      </div>
      <div class="why-copy">
        <span class="eyebrow">Why Hunting Tanner Construction</span>
        <h2>Three generations of building experience</h2>
        <span class="rule"></span>
        <p>
          Hunting is a third-generation contractor who grew up on job sites
          alongside his dad, Gary, a general contractor with more than 35
          years of experience. Hunting owns and runs every project start to
          finish, with Gary serving as senior advisor and involved in each
          one. You get a new company's attention and a veteran's judgment.
        </p>
        <ul class="why-points">
          <li>
            <strong>An owner on every project.</strong> The person who plans
            your job is the person who answers for it.
          </li>
          <li>
            <strong>Written scopes, not verbal ones.</strong> Defined room
            by room before pricing, so the proposal means something.
          </li>
          <li>
            <strong>Change orders in writing.</strong> Documented and priced
            before the work proceeds. No surprise invoices.
          </li>
          <li>
            <strong>Licensed &amp; insured.</strong> A licensed Utah general
            contractor working with qualified trade partners.
          </li>
        </ul>
        <a class="link-label" href="/about/">Read the full story</a>
      </div>
    </div>
  </section>

  {/* ============ Service areas ============ */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">Where We Work</span>
      <h2>Serving homeowners at their properties</h2>
      <p class="lede">
        A Utah County based residential contractor serving Utah County and
        the Salt Lake Valley. We come to you.
      </p>
      <div class="grid-3 areas-grid">
        {featuredCities.map((area) => (
          <ServiceAreaCard area={area} />
        ))}
      </div>

      <div class="counties-card">
        <div class="counties-copy">
          <h3>Two counties, every community</h3>
          <p>
            Every city we work in has its own local page.
          </p>
        </div>
        <div class="counties-links">
          {featuredCounties.map((county) => (
            <a class="btn btn--secondary" href={county.href}>
              {county.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ============ Google reviews (renders only when real reviews exist) === */}
  <GoogleReviews />

  {/* ============ FAQ ============ */}
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Questions Homeowners Ask</span>
      <h2>Basement finishing FAQs</h2>
      <FAQAccordion faqs={homeFaqs.slice(0, 5)} />
      <p class="section-cta">
        <a href="/faq/">See all frequently asked questions →</a>
      </p>
    </div>
  </section>

  {/* ============ Closing CTA ============ */}
  {/* Buttons only, not a second form: the page already carries a full
      form high up plus the sticky mobile bar, and the reference layout
      closes on a heading and a single CTA. */}
  <CTASection
    heading="Your basement is already under your roof. Let's finish it."
    text="Tell us about your space and what you want it to become. A real conversation, clear next steps, zero pressure."
  />
</BaseLayout>

<style>
  /* ---- Hero: photography leads, copy overlays it ----
     The image is taken out of flow so the section height is controlled by
     min-height and the copy, not by the photograph's aspect ratio. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    isolation: isolate;
    background: var(--color-dark);
    min-height: min(82vh, 44rem);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }
  /* A soft directional scrim, not a heavy darkening — the photograph
     should still read as bright and warm. */
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(44 49 53 / 0.78) 0%,
      rgb(44 49 53 / 0.55) 38%,
      rgb(44 49 53 / 0.12) 68%,
      rgb(44 49 53 / 0.02) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-9);
  }
  .hero-copy {
    max-width: 34rem;
  }
  .hero-eyebrow {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-on-dark-accent);
    margin-bottom: var(--space-5);
  }
  .hero-copy h1 {
    color: var(--color-on-dark);
    margin-bottom: 0;
  }
  .hero-copy .rule {
    background: var(--color-on-dark-accent);
    margin-block: var(--space-5);
  }
  .hero-lede {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-on-dark);
    max-width: 30rem;
    margin-bottom: var(--space-6);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  @media (max-width: 767px) {
    .hero {
      min-height: 32rem;
      align-items: flex-end;
    }
    /* Bottom-weighted scrim on small screens: the copy sits over the lower
       third, where the photograph is quietest. */
    .hero-media::after {
      background: linear-gradient(
        180deg,
        rgb(44 49 53 / 0.2) 0%,
        rgb(44 49 53 / 0.55) 48%,
        rgb(44 49 53 / 0.88) 100%
      );
    }
    .hero-content {
      padding-block: var(--space-8) var(--space-7);
    }
    .hero-lede {
      font-size: var(--text-base);
    }
    .hero-actions .btn {
      flex: 1 1 auto;
    }
  }

  /* ---- Consultation band ---- */
  .consult-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 900px) {
    .consult-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
  .consult-copy p {
    color: var(--color-text-muted);
  }
  .consult-note {
    font-size: var(--text-sm);
  }

  .transform-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .transform-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
  .transform-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .services-grid,
  .areas-grid,
  .projects-grid {
    margin-top: var(--space-6);
  }

  /* ---- Why HTC + founder story, on the warm off-white band (section--alt).
         Do NOT put this back on solid Pale Taupe: it was rejected. ---- */
  .why-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .why-grid {
      grid-template-columns: 4fr 6fr;
      gap: var(--space-8);
    }
  }
  .why-media {
    max-width: 24rem;
    margin-inline: auto;
    width: 100%;
  }
  .why-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
  .why-points {
    list-style: none;
    margin: var(--space-5) 0 var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .why-points li {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--brand-sea-glass);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* ---- Process, on Charcoal ---- */
  .process-head {
    max-width: 46rem;
  }
  .process-preview {
    margin-top: var(--space-7);
  }
  /* Compact summary of what the six steps cover end to end */
  .process-manage {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }
  @media (min-width: 640px) {
    .process-manage {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .process-manage {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .process-manage li {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--brand-sea-glass);
    color: var(--color-text);
  }

  .section-cta {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  /* Counties block: one wider card beneath the three city cards, so the
     county-wide hubs read as a different tier rather than a fourth city. */
  .counties-card {
    margin-top: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--brand-sea-glass);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  @media (min-width: 800px) {
    .counties-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-5) var(--space-6);
    }
  }
  .counties-copy h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .counties-copy p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: 0;
    max-width: 40rem;
  }
  .counties-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .counties-links .btn {
    white-space: nowrap;
  }

</style>
