---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LeadForm from "@/components/LeadForm.astro";
import TrustStrip from "@/components/TrustStrip.astro";
import BeforeAfterSlider from "@/components/BeforeAfterSlider.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import OwnerStory from "@/components/OwnerStory.astro";
import ServiceAreaCard from "@/components/ServiceAreaCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import CTASection from "@/components/CTASection.astro";
import { business } from "@/config/business";
import { coreServices } from "@/data/services";
import { featuredCities, featuredCounties } from "@/data/service-areas";
import { homeFaqs } from "@/data/faqs";
import { publishableProjects } from "@/data/projects";
import GoogleReviews from "@/components/GoogleReviews.astro";
import { serviceSchema } from "@/lib/schema";
import heroImage from "@/assets/hero/basement-after.png";
import beforeImg from "@/assets/hero/basement-before.png";
import afterImg from "@/assets/hero/basement-after.png";
---

<BaseLayout
  title="Utah Basement Finishing Company | Hunting Tanner Construction"
  description="Utah basement finishing specialists serving Utah County and the Salt Lake Valley. A licensed basement finishing contractor with three generations of building experience. Free consultation."
  path="/"
  includeOrgSchema
  schemas={[serviceSchema({
    name: "Basement Finishing",
    description:
      "Complete basement finishing for Utah homeowners: space planning, framing, electrical, plumbing, drywall, trim, and flooring, managed under a written scope by a licensed Utah general contractor.",
    path: "/",
  })]}
>
  {/* ============ Hero: full-bleed photography with overlaid copy ====== */}
  <section class="hero">
    <div class="hero-media">
      <Image
        src={heroImage}
        alt="Finished Utah basement with an open kitchen, island seating, and family room"
        width={2000}
        height={1500}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero-content">
      <div class="hero-copy">
        <span class="hero-eyebrow">Utah County &amp; the Salt Lake Valley</span>
        <h1>Utah Basement<br />Finishing Specialists</h1>
        <span class="rule"></span>
        <p class="hero-lede">
          A licensed Utah basement finishing company turning unfinished
          basements into bedrooms, bathrooms, and living space.
        </p>
        <div class="hero-actions">
          <a
            class="btn btn--secondary"
            href="#home-lead-form"
            data-event="cta_click"
            data-event-label="hero"
          >
            Request a Consultation
          </a>
          <a
            class="btn btn--ghost-light"
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="hero"
          >
            Call {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ============ Trust strip ============ */}
  <TrustStrip />

  {/* ============ Consultation: kept high on the page for conversion === */}
  <section class="section section--alt" id="home-lead-form">
    <div class="container consult-grid">
      <div class="consult-copy">
        <span class="eyebrow">Start Here</span>
        <h2>Tell us about your basement</h2>
        <span class="rule"></span>
        <p>
          Every project begins the same way: a short conversation about
          your space, then a walkthrough at your home. You'll get straight
          answers about what's realistic, what it costs, and how long it
          takes, in writing.
        </p>
        <p class="consult-note">
          Prefer to talk now? Call
          <a
            href={business.phoneHref}
            data-event="click_to_call"
            data-event-label="consult-section"
          >{business.phoneDisplay}</a>
          and speak directly with the owner, not a call center.
        </p>
      </div>
      <div class="consult-form">
        <LeadForm formId="home-form" variant="compact" />
      </div>
    </div>
  </section>

  {/* ============ E. Transformation ============ */}
  <section class="section">
    <div class="container">
      <div class="transform-grid">
        <div>
          <span class="eyebrow">The Transformation</span>
          <h2>From concrete and studs to the best floor in the house</h2>
          <p>
            Most Utah County homes come with hundreds of unfinished square
            feet already under the roof: framed, plumbed for a future
            bathroom, and waiting. Finishing that space is usually the most
            cost-effective way to add bedrooms, a family room, or a home
            office, because the foundation, walls, and roof are already paid
            for.
          </p>
          <p>
            What stands between the concrete floor and a finished space is a
            well-run project: a clear layout, a written scope, coordinated
            trades, passed inspections, and finish work done in the right
            order. That project management is exactly what Hunting Tanner
            Construction is built around. Drag the slider to see the same
            room, before and after.
          </p>
          <a class="btn btn--secondary" href="#basement-finishing-scope">
            See What's Included
          </a>
        </div>
        <BeforeAfterSlider
          before={beforeImg}
          after={afterImg}
          beforeAlt="Unfinished basement with exposed framing, ductwork, and concrete floor"
          afterAlt="The same basement finished with a kitchen, island, and furnished family room"
        />
      </div>
    </div>
  </section>

  {/* ============ Scope: what a Utah basement finish includes ============ */}
  <section class="section" id="basement-finishing-scope">
    <div class="container container--narrow">
      <span class="eyebrow">What's Included</span>
      <h2>What a Utah basement finish includes</h2>
      <p>
        A basement finish touches nearly every construction trade: framing,
        electrical, plumbing, HVAC, insulation, drywall, paint, doors, trim,
        and flooring, sequenced in the right order and inspected at the
        right stages. When those pieces are coordinated well, the project
        feels surprisingly calm. When they aren't, homeowners get the
        stories you've heard from neighbors.
      </p>
      <ul>
        <li>
          <strong>Layout and space planning</strong>: bedroom placement,
          bathroom location relative to plumbing rough-ins, family-room
          sizing, and storage that's planned instead of leftover.
        </li>
        <li>
          <strong>Permits and inspections</strong>: coordinated with your
          city's building department and scheduled into the timeline.
        </li>
        <li>
          <strong>Framing and insulation</strong>: exterior wall furring,
          interior walls, soffits around mechanical runs, and sound
          insulation where it matters.
        </li>
        <li>
          <strong>Electrical</strong>: lighting layout, outlets, smoke and
          CO detection, and circuits for how the space will actually be
          used.
        </li>
        <li>
          <strong>Plumbing and HVAC</strong>: bathroom completion from the
          rough-in, wet-bar supply and drain, and heating and cooling
          balanced for below-grade comfort.
        </li>
        <li>
          <strong>Drywall, paint, doors, and trim</strong>: the finish
          stage where the space starts looking like the rest of your home.
        </li>
        <li>
          <strong>Flooring and fixtures</strong>: carpet, LVP, or tile
          selected through organized allowances.
        </li>
      </ul>
      <p>
        Every project runs on the same structure:
        <a href="/process/">a six-step process</a> with a written scope, an
        itemized proposal, and change orders documented before any changed
        work proceeds.
      </p>
    </div>
  </section>

  {/* ============ F. Core services ============ */}
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What We Build</span>
      <h2>Basement spaces designed around how you live</h2>
      <p class="lede">
        Every basement starts as square footage. The plan is what turns it
        into the rooms your family actually needs.
      </p>
      <div class="grid-3 services-grid">
        {coreServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  {/* ============ Popular spaces (anchor targets for service cards) ====== */}
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Popular Spaces</span>
      <h2>The rooms Utah homeowners add most</h2>

      <h3 id="bathrooms-bedrooms">Basement bathrooms &amp; bedrooms</h3>
      <p>
        A conforming bedroom and a full bathroom are the two additions that
        change how a basement counts, for daily life and for how the home
        functions with guests, teenagers, or family staying long-term.
        Bedrooms need proper egress windows and smoke detection; bathrooms
        need supply, drain, and ventilation done right. Both get planned
        around your home's existing rough-ins and window locations.
      </p>

      <h3 id="family-rooms">Family &amp; entertainment rooms</h3>
      <p>
        The big open room is the heart of most basement projects: movie
        nights, game tables, toy space, hosting. Good ones are designed
        deliberately, with TV wall placement decided before the electrical
        goes in, lighting zones instead of one switch, sound control in the
        ceiling, and storage built into the plan.
      </p>

      <h3 id="wet-bars">Wet bars &amp; kitchenettes</h3>
      <p>
        A snack center with a sink, drink fridge, microwave shelf, and real
        cabinetry keeps popcorn nights downstairs, and makes the space feel
        finished in a way paint alone never does. Full kitchenettes can also
        support long-term guests. We'll talk honestly about which level fits
        your budget and how each affects plumbing scope.
      </p>

      <h3 id="offices-gyms">Home offices &amp; gyms</h3>
      <p>
        Basements make excellent offices and gyms for the same reasons:
        quiet, separation, and stable temperatures. Offices get planned for
        lighting quality and outlets where the desk actually goes. Gyms get
        durable flooring, mirrors, ventilation, and ceiling clearance
        checked before anything is built.
      </p>
    </div>
  </section>

  {/* ============ Cost + timeline ============ */}
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Cost &amp; Timeline</span>
      <h2>What basement finishing costs in Utah</h2>
      <p>
        Homeowners deserve a straight answer on pricing, and the honest one
        is that basements vary widely. The main drivers are:
      </p>
      <ul>
        <li><strong>Square footage</strong> being finished</li>
        <li><strong>Bathrooms</strong>: count, and whether a rough-in exists</li>
        <li><strong>Wet features</strong>: bars and kitchenettes add plumbing and cabinetry</li>
        <li><strong>Bedroom count</strong>: egress windows and closets</li>
        <li><strong>Finish level</strong>: flooring, tile, cabinetry, and built-in choices</li>
        <li><strong>Existing conditions</strong>: ceiling height, mechanical layout, moisture</li>
      </ul>
      <p>
        Rather than quoting a misleading per-square-foot number, we walk the
        space, write the scope, and price it line by line, so you can see
        exactly where the investment goes and adjust the plan before
        construction, not during it. If you share a target range early,
        we'll design the scope around it.
      </p>

      <h3>How long a basement finish takes</h3>
      <p>
        Most projects take anywhere from 4-8 weeks typically, depending on
        size, the number of wet areas, inspection scheduling, and selection
        lead times. Your proposal includes an estimated timeline for your
        specific scope, and weekly updates keep you current once work
        begins.
      </p>
    </div>
  </section>

  {/* ============ G. Why HTC ============ */}
  <section class="section section--alt">
    <div class="container">
      <div class="why-grid">
        <div>
          <span class="eyebrow">Why Hunting Tanner Construction</span>
          <h2>Three generations of building. Zero tolerance for chaos.</h2>
          <p>
            Ask homeowners about their remodel horror stories and the same
            themes come up: vague bids, phone calls that go nowhere, scope
            that shifts without warning, and invoices that don't match
            conversations. None of that is a craftsmanship problem. It's a
            management problem, and it's exactly what this company was
            founded to fix.
          </p>
        </div>
        <ul class="why-list">
          <li>
            <h3>A third-generation contractor</h3>
            <p>
              Hunting grew up on job sites alongside his dad Gary, a general
              contractor with over 30 years of experience and co-founder of
              HTC. The trade network and standards come with the name.
            </p>
          </li>
          <li>
            <h3>An owner on every project</h3>
            <p>
              Hunting is personally involved in every single project, on
              site and reachable. The person who plans your job is the
              person who answers for it.
            </p>
          </li>
          <li>
            <h3>Written scopes, not verbal ones</h3>
            <p>
              Your project is defined room by room before pricing, so the
              proposal means something and changes are visible.
            </p>
          </li>
          <li>
            <h3>Change orders in writing</h3>
            <p>
              When scope changes, because you added something or an
              inspector required something, it's documented and priced
              before the work proceeds.
            </p>
          </li>
          <li>
            <h3>Regular, honest updates</h3>
            <p>
              You'll know what happened this week, what's next, and which
              decisions are coming. When something slips, you hear it from
              us first, with the why.
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ============ H. Process preview ============ */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">How It Works</span>
      <h2>Six clear steps from first call to final walkthrough</h2>
      <div class="process-preview">
        <ProcessSteps compact />
      </div>
      <div class="section-cta">
        <a class="btn btn--secondary" href="/process/">
          See the Full Process
        </a>
      </div>
    </div>
  </section>

  {/* ============ I. Founders story ============ */}
  <section class="section">
    <div class="container">
      <OwnerStory variant="home" />
    </div>
  </section>

  {/* ============ J. Service areas ============ */}
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Where We Work</span>
      <h2>Serving homeowners at their properties</h2>
      <p class="lede">
        Hunting Tanner Construction is a Utah County based residential
        contractor and service-area business. We come to you.
      </p>
      <div class="grid-3 areas-grid">
        {featuredCities.map((area) => (
          <ServiceAreaCard area={area} />
        ))}
      </div>

      <div class="counties-card">
        <div class="counties-copy">
          <h3>Two counties, every community</h3>
          <p>
            Beyond our featured cities, we serve homeowners throughout
            Utah County and across the Salt Lake Valley. Every city we
            work in has its own local page.
          </p>
        </div>
        <div class="counties-links">
          {featuredCounties.map((county) => (
            <a class="btn btn--secondary" href={county.href}>
              {county.name}
            </a>
          ))}
        </div>
      </div>

      <p class="nearby-note">
        Close by but not listed? <a href="/contact/">Ask us</a> and you'll
        get a straight answer about scheduling and fit.
      </p>
    </div>
  </section>

  {/* ============ K. Project gallery preview ============ */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">Our Work</span>
      <h2>Basements we've finished</h2>
      <p class="lede">
        Kitchens, kitchenettes, bathrooms, bedrooms, and big family spaces,
        photographed room by room. See what a finished Tanner basement
        looks like.
      </p>
      <div class="grid-3 projects-grid">
        {publishableProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn--secondary" href="/projects/">
          View the Full Galleries
        </a>
      </div>
    </div>
  </section>

  {/* ============ Google reviews (renders only when real reviews exist) === */}
  <GoogleReviews />

  {/* ============ L. FAQ ============ */}
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Questions Homeowners Ask</span>
      <h2>Basement finishing FAQs</h2>
      <FAQAccordion faqs={homeFaqs.slice(0, 7)} />
      <p class="section-cta">
        <a href="/faq/">See all frequently asked questions →</a>
      </p>
    </div>
  </section>

  {/* ============ M. Final CTA with form ============ */}
  <CTASection
    withForm
    formId="home-footer-form"
    heading="Your basement is already under your roof. Let's finish it."
    text="Tell us about your space and what you want it to become. You'll get a real conversation, clear next steps, and zero pressure."
  />
</BaseLayout>

<style>
  /* ---- Hero: photography leads, copy overlays it ----
     The image is taken out of flow so the section height is controlled by
     min-height and the copy, not by the photograph's aspect ratio. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    isolation: isolate;
    background: var(--color-dark);
    min-height: min(82vh, 44rem);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }
  /* A soft directional scrim, not a heavy darkening — the photograph
     should still read as bright and warm. */
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(44 49 53 / 0.78) 0%,
      rgb(44 49 53 / 0.55) 38%,
      rgb(44 49 53 / 0.12) 68%,
      rgb(44 49 53 / 0.02) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-9);
  }
  .hero-copy {
    max-width: 34rem;
  }
  .hero-eyebrow {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-on-dark-accent);
    margin-bottom: var(--space-5);
  }
  .hero-copy h1 {
    color: var(--color-on-dark);
    margin-bottom: 0;
  }
  .hero-copy .rule {
    background: var(--color-on-dark-accent);
    margin-block: var(--space-5);
  }
  .hero-lede {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-on-dark);
    max-width: 30rem;
    margin-bottom: var(--space-6);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  @media (max-width: 767px) {
    .hero {
      min-height: 32rem;
      align-items: flex-end;
    }
    /* Bottom-weighted scrim on small screens: the copy sits over the lower
       third, where the photograph is quietest. */
    .hero-media::after {
      background: linear-gradient(
        180deg,
        rgb(44 49 53 / 0.2) 0%,
        rgb(44 49 53 / 0.55) 48%,
        rgb(44 49 53 / 0.88) 100%
      );
    }
    .hero-content {
      padding-block: var(--space-8) var(--space-7);
    }
    .hero-lede {
      font-size: var(--text-base);
    }
    .hero-actions .btn {
      flex: 1 1 auto;
    }
  }

  /* ---- Consultation band ---- */
  .consult-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 900px) {
    .consult-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
  .consult-copy p {
    color: var(--color-text-muted);
  }
  .consult-note {
    font-size: var(--text-sm);
  }

  .transform-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .transform-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
  .transform-grid .btn {
    margin-top: var(--space-4);
  }

  .services-grid,
  .areas-grid,
  .projects-grid {
    margin-top: var(--space-6);
  }

  .why-grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 900px) {
    .why-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }
  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .why-list li {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--brand-sea-glass);
  }
  .why-list h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }
  .why-list p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: 0;
  }

  .process-preview {
    margin-top: var(--space-6);
  }

  .section-cta {
    margin-top: var(--space-6);
    text-align: center;
  }

  /* Counties block: one wider card beneath the three city cards, so the
     county-wide hubs read as a different tier rather than a fourth city. */
  .counties-card {
    margin-top: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-left: 2px solid var(--brand-sea-glass);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  @media (min-width: 800px) {
    .counties-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      padding: var(--space-5) var(--space-6);
    }
  }
  .counties-copy h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .counties-copy p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: 0;
    max-width: 40rem;
  }
  .counties-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .counties-links .btn {
    white-space: nowrap;
  }

  .nearby-note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: 52rem;
  }
</style>
