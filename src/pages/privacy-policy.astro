---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { breadcrumbSchema } from "@/lib/schema";
import { business } from "@/config/business";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Privacy Policy", path: "/privacy-policy/" },
];

const schemas = [breadcrumbSchema(breadcrumbs)];

{/* EDITORIAL NOTE: Have this policy reviewed by an attorney before launch,
    and update the effective date at that time. See CONTENT-TODO.md. */}
const effectiveDate = "July 30, 2026";
---

<BaseLayout
  title="Privacy Policy | Hunting Tanner Construction"
  description="How Hunting Tanner Construction LLC collects, uses, and protects information submitted through huntingtanner.com."
  path="/privacy-policy/"
  schemas={schemas}
>
  <PageIntro heading="Privacy Policy" breadcrumbs={breadcrumbs} />

  <section class="section">
    <div class="container container--narrow prose">
      <p><em>Effective date: {effectiveDate}</em></p>

      <p>
        This policy explains how {business.legalName} ("HTC," "we," "us")
        handles information collected through {business.domain} (the
        "Site"). We keep it in plain English on purpose.
      </p>

      <h2>Information you give us</h2>
      <p>
        When you submit a consultation or contact form, we collect what you
        enter: your name, phone number, email address, project city,
        project details, and any optional fields you choose to complete
        (such as timing or investment range). We use this information to
        respond to your inquiry, evaluate and plan your project, and
        communicate with you about it by phone, text, or email, as the
        consent statement on the form describes.
      </p>
      <p>
        We do not sell your personal information, and we do not add you to
        marketing lists just because you asked a question.
      </p>

      <h2>Information collected automatically</h2>
      <p>
        Like most websites, the Site may collect standard technical
        information, such as pages visited, referring pages, and
        campaign parameters (for example, which ad or search brought you
        here). When our forms are submitted, this attribution information
        may be included so we understand how homeowners find us.
      </p>
      <p>
        If we enable analytics services (such as Google Analytics) or
        advertising measurement tools (such as Google Ads or Meta
        conversion tracking), those services may set cookies or collect
        usage data under their own privacy policies. We configure such
        tools for business measurement, not for building personal
        profiles.
      </p>

      <h2>How information is shared</h2>
      <p>
        Your information is shared only as needed to run the business: with
        service providers that deliver our email and website
        infrastructure, and with trade partners strictly as needed to plan
        or perform your project. We don't share your contact information
        with unrelated third parties for their marketing.
      </p>

      <h2>Retention and security</h2>
      <p>
        We keep inquiry and project records as long as reasonably needed
        for business, legal, and warranty purposes. We use reputable
        providers and reasonable safeguards, but no internet transmission
        is perfectly secure, so please don't submit sensitive personal
        information through the Site.
      </p>

      <h2>Your choices</h2>
      <p>
        You can ask us to correct or delete your contact information, or to
        stop contacting you, at any time. Email
        <a href={business.emailHref}>{business.email}</a> or call
        <a href={business.phoneHref}>{business.phoneDisplay}</a>. To opt
        out of text messages, reply STOP.
      </p>

      <h2>Children</h2>
      <p>
        The Site is intended for adults and doesn't knowingly collect
        information from children under 13.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        If this policy changes, we'll post the updated version here with a
        new effective date.
      </p>

      <h2>Contact</h2>
      <p>
        {business.legalName}<br />
        <a href={business.emailHref}>{business.email}</a><br />
        <a href={business.phoneHref}>{business.phoneDisplay}</a>
      </p>
    </div>
  </section>
</BaseLayout>
