# ============================================================
# Hunting Tanner Construction — environment variables
# Copy to .env for local overrides. NONE of these are required
# to run or preview the site locally.
# ============================================================

# "staging" (noindex, forms disabled) or "live"
# Overrides the default in src/config/business.ts
PUBLIC_SITE_STATUS="staging"

# ---- Analytics (only injected when siteStatus is "live" AND the ID is set) ----
PUBLIC_GA_MEASUREMENT_ID=""
PUBLIC_GOOGLE_ADS_ID=""
PUBLIC_META_PIXEL_ID=""

# Google Search Console verification token (content of the meta tag)
PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---- Contact form (/api/contact serverless endpoint) ----
# Where lead notifications are sent
CONTACT_NOTIFICATION_EMAIL="office@huntingtanner.com"

# Transactional mail provider — REQUIRED IN VERCEL for lead emails to send.
# 1. Create a free account at resend.com
# 2. Verify the huntingtanner.com domain (Dashboard → Domains)
# 3. Create an API key and set it in Vercel → Settings → Environment Variables
RESEND_API_KEY=""

# Verified sender once the domain is verified, e.g.
# "HTC Website <leads@huntingtanner.com>". Until then the endpoint falls
# back to Resend's onboarding sender.
RESEND_FROM=""

# Cloudflare Turnstile spam protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
