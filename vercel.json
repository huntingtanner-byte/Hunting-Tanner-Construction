{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    },
    {
      "source": "/basement-finishing",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/basement-finishing/",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
