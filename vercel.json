{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/basement-finishing",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/basement-finishing/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.huntingtanner.com" }],
      "destination": "https://huntingtanner.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "huntingtannerconstruction.com" }],
      "destination": "https://huntingtanner.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.huntingtannerconstruction.com" }],
      "destination": "https://huntingtanner.com/:path*",
      "permanent": true
    }
  ]
}
